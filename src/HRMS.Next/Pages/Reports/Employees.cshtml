@page "/Reports/Employees"
@model HRMS.Next.Pages.Reports.EmployeesModel
@using HRMS.Next.Pages.Employees
@{ ViewData["Title"] = "گزارش لیست کارکنان"; }
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap"><h1>گزارش لیست کارکنان</h1><div class="d-flex gap-2"><a asp-page-handler="Export" asp-route-keyword="@Model.Keyword" asp-route-departmentId="@Model.DepartmentId" asp-route-status="@Model.Status" class="btn btn-hero"><i class="bi bi-file-earmark-spreadsheet"></i> خروجی CSV</a><button type="button" class="btn btn-hero" onclick="window.print();"><i class="bi bi-printer"></i> چاپ</button><a asp-page="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> گزارش‌ها</a></div></div>
}
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label" for="keyword">جستجو</label><input type="search" class="form-control" id="keyword" name="keyword" value="@Model.Keyword" /></div><div class="col-md-3"><label class="form-label" for="departmentId">واحد سازمانی</label><select class="form-select" id="departmentId" name="departmentId"><option value="">همه واحدها</option>@foreach (var department in Model.Departments) { <option value="@department.Id" selected="@(Model.DepartmentId == department.Id)">@department.Name</option> }</select></div><div class="col-md-3"><label class="form-label" for="status">وضعیت</label><select class="form-select" id="status" name="status"><option value="">همه</option><option value="Active" selected="@(Model.Status == "Active")">شاغل</option><option value="OnLeave" selected="@(Model.Status == "OnLeave")">مرخصی تأییدشدهٔ امروز</option><option value="Terminated" selected="@(Model.Status == "Terminated")">خروج قطعی</option></select></div><div class="col-md-2"><button type="submit" class="btn btn-primary w-100">اجرا</button></div></form></div></div>
@if (Model.Result is { } result)
{
    <div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-striped table-sm align-middle text-center"><thead><tr><th>کد</th><th>نام</th><th>عنوان شغلی</th><th>واحد</th><th>مدیر</th><th>ایمیل</th><th>استخدام</th><th>وضعیت</th></tr></thead><tbody>
        @if (result.Rows.Count == 0) { <tr><td colspan="8" class="text-muted py-4">داده‌ای برای نمایش وجود ندارد.</td></tr> }
        @foreach (var row in result.Rows) { <tr><td>@row.EmployeeNumber</td><td class="text-start"><a asp-page="/Employees/Details" asp-route-id="@row.EmployeeId">@row.FullName</a></td><td>@(row.JobTitle ?? "-")</td><td>@row.DepartmentName</td><td>@(row.ManagerName ?? "-")</td><td dir="ltr" class="small">@row.Email</td><td>@JalaliDate.Format(row.HireDate)</td><td><span class="badge text-bg-@(row.Terminated ? "secondary" : row.IsOnLeave ? "warning" : "success")">@ProfileDisplay.EmploymentStatusLabel(row.Terminated, row.IsOnLeave)</span></td></tr> }
    </tbody></table></div><div class="d-flex justify-content-between align-items-center"><span>تعداد: @result.Total</span><div class="d-flex gap-2">@if (result.Page > 1) { <a asp-page="Employees" asp-route-keyword="@Model.Keyword" asp-route-departmentId="@Model.DepartmentId" asp-route-status="@Model.Status" asp-route-pageNumber="@(result.Page - 1)" class="btn btn-sm btn-outline-primary">قبلی</a> }@if (result.Page * result.PageSize < result.Total) { <a asp-page="Employees" asp-route-keyword="@Model.Keyword" asp-route-departmentId="@Model.DepartmentId" asp-route-status="@Model.Status" asp-route-pageNumber="@(result.Page + 1)" class="btn btn-sm btn-outline-primary">بعدی</a> }</div></div></div></div>
}
