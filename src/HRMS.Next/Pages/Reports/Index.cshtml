@page "/Reports"
@model HRMS.Next.Pages.Reports.IndexModel
@{ ViewData["Title"] = "گزارش‌ها"; }
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap"><h1>گزارش‌ها</h1><a asp-page="/Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> خانه</a></div>
}
@if (Model.Stats is { } stats)
{
    <div class="row g-3">
        <div class="col-md-6 col-lg-4"><div class="card h-100"><div class="card-body"><h5><i class="bi bi-person-lines-fill text-primary"></i> گزارش لیست کارکنان</h5><p class="text-muted small">فیلتر بر اساس واحد، وضعیت و نام، با خروجی CSV.</p><a asp-page="Employees" class="btn btn-primary">اجرای گزارش</a></div><div class="card-footer bg-white text-muted small">کل کارکنان: @stats.TotalEmployees</div></div></div>
        <div class="col-md-6 col-lg-4"><div class="card h-100"><div class="card-body"><h5><i class="bi bi-calendar-check text-success"></i> گزارش خلاصه مرخصی</h5><p class="text-muted small">تعلق‌گرفته، استفاده‌شده و مانده هر کارمند در سال انتخابی.</p><a asp-page="Leave" class="btn btn-success">اجرای گزارش</a></div><div class="card-footer bg-white text-muted small">در انتظار تأیید: @stats.PendingRequests</div></div></div>
        <div class="col-md-6 col-lg-4"><div class="card h-100"><div class="card-body"><h5><i class="bi bi-bar-chart text-info"></i> آمار سریع</h5><ul class="list-group list-group-flush small"><li class="list-group-item d-flex justify-content-between"><span>شاغل</span><strong>@stats.ActiveEmployees</strong></li><li class="list-group-item d-flex justify-content-between"><span>مرخصی تأییدشدهٔ امروز</span><strong>@stats.OnLeaveEmployees</strong></li><li class="list-group-item d-flex justify-content-between"><span>استخدام جدید امسال</span><strong>@stats.NewHiresThisYear</strong></li><li class="list-group-item d-flex justify-content-between"><span>میانگین اندازه تیم</span><strong>@stats.AverageTeamSize</strong></li></ul></div></div></div>
    </div>
}
