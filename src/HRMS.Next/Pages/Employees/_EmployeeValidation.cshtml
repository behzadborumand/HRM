@model string
@{
    var errors = ViewData.ModelState
        .Where(entry => entry.Key == Model || entry.Key.StartsWith(Model + ".", StringComparison.Ordinal) || (Model == "Form" && entry.Key == ""))
        .SelectMany(entry => entry.Value!.Errors)
        .Select(error => string.IsNullOrWhiteSpace(error.ErrorMessage) ? "مقدار واردشده معتبر نیست." : error.ErrorMessage).ToArray();
}
@if (errors.Length > 0)
{
    <div class="text-danger validation-summary-errors" role="alert"><ul>@foreach (var error in errors) { <li>@error</li> }</ul></div>
}