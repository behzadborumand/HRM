@model HRMS.Next.Pages.Employees.EmployeeForm
<partial name="_EmployeeValidation" model="@ViewData.TemplateInfo.HtmlFieldPrefix" />
<div class="row g-3">
    <div class="col-12">
        <h6 class="text-primary border-bottom pb-2"><i class="bi bi-person-vcard"></i> اطلاعات شخصی</h6>
    </div>
    <div class="col-md-3">
        <label asp-for="EmployeeNumber" class="form-label">کد پرسنلی</label>
        <input asp-for="EmployeeNumber" class="form-control" required />
        <span asp-validation-for="EmployeeNumber" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="FirstName" class="form-label">نام</label>
        <input asp-for="FirstName" class="form-control" required autocomplete="given-name" />
        <span asp-validation-for="FirstName" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="LastName" class="form-label">نام خانوادگی</label>
        <input asp-for="LastName" class="form-control" required autocomplete="family-name" />
        <span asp-validation-for="LastName" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Email" class="form-label">ایمیل</label>
        <input asp-for="Email" class="form-control" type="email" dir="ltr" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="col-12 mt-3">
        <h6 class="text-primary border-bottom pb-2"><i class="bi bi-briefcase"></i> اطلاعات شغلی</h6>
    </div>
    <div class="col-md-6">
        <label asp-for="DepartmentId" class="form-label">واحد سازمانی</label>
        @if (ViewData["LockDepartment"] is true)
        {
            var departments = (IReadOnlyList<HRMS.Next.Modules.Organization.DepartmentOption>)(ViewData["Departments"] ?? Array.Empty<HRMS.Next.Modules.Organization.DepartmentOption>());
            var departmentName = departments.FirstOrDefault(x => x.Id == Model.DepartmentId)?.Name ?? "-";
            <input asp-for="DepartmentId" type="hidden" />
            <input type="text" class="form-control" value="@departmentName" readonly aria-label="واحد سازمانی فعلی" />
            <div class="form-text"><a href="#job-change">تغییر واحد را در بخش ثبت تغییر شغل انجام دهید.</a></div>
        }
        else
        {
            <select asp-for="DepartmentId" class="form-select" required>
                <option value="0">انتخاب کنید</option>
                @foreach (var department in (IReadOnlyList<HRMS.Next.Modules.Organization.DepartmentOption>)(ViewData["Departments"] ?? Array.Empty<HRMS.Next.Modules.Organization.DepartmentOption>()))
                {
                    <option value="@department.Id">@department.Name</option>
                }
            </select>
        }
        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="HireDateJalali" class="form-label">تاریخ استخدام شمسی</label>
        <input asp-for="HireDateJalali" class="form-control" dir="ltr" placeholder="۱۴۰۳/۰۱/۰۱" required />
        <span asp-validation-for="HireDateJalali" class="text-danger small"></span>
    </div>
</div>
<input asp-for="Version" type="hidden" />
