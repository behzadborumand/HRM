@model IReadOnlyList<HRMS.Next.Modules.Personnel.EmploymentStatusRow>
@{ string Fa(string value) => string.Concat(value.Select(c => c is >= '0' and <= '9' ? (char)('۰' + c - '0') : c)); }
<section class="card" aria-labelledby="status-history-title">
    <div class="card-header"><h3 id="status-history-title"><i class="bi bi-clock-history" aria-hidden="true"></i> سابقهٔ وضعیت اشتغال</h3></div>
    <div class="card-body table-responsive"><table class="table align-middle mb-0"><caption class="visually-hidden">آخرین ۱۰۰ تغییر وضعیت اشتغال</caption>
        <thead><tr><th scope="col">تاریخ مؤثر</th><th scope="col">وضعیت قبلی</th><th scope="col">وضعیت جدید</th></tr></thead><tbody>
        @if (Model.Count == 0) { <tr><td colspan="3" class="profile-empty">تغییر وضعیتی ثبت نشده است.</td></tr> }
        @foreach(var row in Model) { <tr data-employment-status="@row.ToStatus"><td>@(row.EffectiveDate is { } date ? Fa(JalaliDate.Format(date)) : "انتقال اولیه؛ تاریخ مؤثر نامشخص")</td><td>@(row.FromStatus is null ? "—" : ProfileDisplay.EmploymentStatusLabel(false,row.FromStatus == "OnLeave"))</td><td>@ProfileDisplay.EmploymentStatusLabel(false,row.ToStatus == "OnLeave")</td></tr> }
        </tbody></table></div>
</section>