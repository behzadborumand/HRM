@model HRMS.Next.Pages.Employees.DetailsModel
@{
    var training = Model.TrainingProfile!;
    var pages = Math.Max(1, (training.Total - 1) / training.PageSize + 1);
    string Fa(string value) => string.Concat(value.Select(c => c is >= '0' and <= '9' ? (char)('۰' + c - '0') : c));
    string Date(DateOnly value) => Fa(JalaliDate.Format(value));
    string Label(string status) => status switch { "Completed" => "انجام شده", "Overdue" => "از موعد گذشته", _ => "در انتظار انجام" };
}
<div class="tab-pane" id="tab-training" role="tabpanel" aria-labelledby="profile-training-tab" tabindex="0" data-profile-training>
    <h2 class="profile-page-title"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i> آموزش</h2>
    <section class="card" aria-labelledby="training-history-title">
        <div class="card-header">
            <h3 id="training-history-title"><i class="bi bi-journal-check" aria-hidden="true"></i> دوره‌های واگذارشده <span class="profile-record-count">(@Fa(training.Total.ToString()))</span></h3>
            @if (Model.CanManageActivity) { <a asp-page="/Training/Index" class="profile-update-link">مدیریت آموزش <i class="bi bi-chevron-left" aria-hidden="true"></i></a> }
        </div>
        <div class="card-body table-responsive"><table class="table align-middle mb-0">
            <caption class="visually-hidden">دوره‌ها و سوابق آموزش کارمند</caption>
            <thead><tr><th scope="col">دوره</th><th scope="col">برگزارکننده</th><th scope="col">واگذاری</th><th scope="col">سررسید</th><th scope="col">تکمیل</th><th scope="col">وضعیت</th></tr></thead>
            <tbody>
            @if (training.Total == 0) { <tr><td colspan="6" class="profile-empty">دوره‌ای برای این کارمند واگذار نشده است.</td></tr> }
            @foreach (var row in training.Assignments)
            {
                <tr data-profile-assignment-id="@row.Id"><td>@row.CourseTitle</td><td>@(row.Provider ?? "—")</td><td>@Date(row.AssignedDate)</td><td>@(row.DueDate is { } due ? Date(due) : "—")</td><td>@(row.CompletedDate is { } completed ? Date(completed) : "—")</td><td><span class="profile-activity-status @(row.Status == "Completed" ? "is-complete" : row.Status == "Overdue" ? "is-overdue" : "is-pending")">@Label(row.Status)</span></td></tr>
            }
            </tbody>
        </table></div>
        @if (pages > 1)
        {
            <nav class="profile-pagination" aria-label="صفحه‌بندی سوابق آموزش">
                @if (training.Page > 1) { <a asp-page="Details" asp-route-id="@Model.Employee!.Id" asp-route-trainingPage="@(training.Page - 1)" asp-route-leavePage="@Model.LeaveProfile?.Page" asp-fragment="tab-training" data-activity-page="training-previous">قبلی</a> }
                <span aria-current="page">صفحهٔ @Fa(training.Page.ToString()) از @Fa(pages.ToString())</span>
                @if (training.Page < pages) { <a asp-page="Details" asp-route-id="@Model.Employee!.Id" asp-route-trainingPage="@(training.Page + 1)" asp-route-leavePage="@Model.LeaveProfile?.Page" asp-fragment="tab-training" data-activity-page="training-next">بعدی</a> }
            </nav>
        }
    </section>
</div>
