@page "/Employees/Create"
@model HRMS.Next.Pages.Employees.CreateModel
@{
    ViewData["Title"] = "افزودن کارکنان جدید";
}
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <h1>افزودن کارمند جدید</h1>
        <a asp-page="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> بازگشت به لیست</a>
    </div>
}
<div class="card">
    <div class="card-header bg-primary text-white">اطلاعات شخصی و شغلی</div>
    <div class="card-body">
        <form method="post">
            <partial name="_Form" for="Form" />
            <div class="mt-4">
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> ثبت کارمند</button>
                <a asp-page="Index" class="btn btn-secondary">انصراف</a>
            </div>
        </form>
    </div>
</div>
