@page "/Employees/Create"
@model HRMS.Next.Pages.Employees.CreateModel
@{
    ViewData["Title"] = "ثبت کارمند";
}
<p><a asp-page="Index">← بازگشت به فهرست کارکنان</a></p>
<div class="page-intro">
    <div>
        <span class="eyebrow">پرونده پرسنلی</span>
        <h1>ثبت کارمند جدید</h1>
        <p class="muted">اطلاعات اصلی کارمند را وارد کنید.</p>
    </div>
</div>
<form method="post" class="card">
    <h2>اطلاعات اصلی</h2>
    <partial name="_Form" for="Form" />
    <div class="form-actions">
        <button type="submit">ثبت کارمند</button>
        <a class="button button-secondary" asp-page="Index">انصراف</a>
    </div>
</form>
