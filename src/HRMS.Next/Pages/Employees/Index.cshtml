@page "/Employees"
@model HRMS.Next.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "کارکنان";
}
<h1>کارکنان</h1>
<form method="get" class="card">
    <label for="query">جستجو</label><input id="query" name="query" value="@Model.Query" />
    <label for="departmentId">واحد سازمانی</label>
    <select id="departmentId" name="departmentId"><option value="">همه واحدها</option>
        @foreach (var department in Model.Departments)
        {
            <option value="@department.Id" selected="@(Model.DepartmentId == department.Id)">@department.Name</option>
        }
    </select>
    <button type="submit">اعمال فیلتر</button>
</form>
@if (Model.CanWrite) { <p><a class="button" asp-page="Create">ثبت کارمند</a></p> }
@if (Model.Result is { Total: 0 })
{
    <p role="status">کارمندی با این شرایط یافت نشد.</p>
}
else if (Model.Result is not null)
{
    <p role="status">@Model.Result.Total نتیجه</p>
    <table><thead><tr><th>شماره</th><th>نام</th><th>واحد</th><th>تاریخ استخدام</th><th>وضعیت</th></tr></thead><tbody>
    @foreach (var employee in Model.Result.Rows)
    {
        <tr><td>@employee.EmployeeNumber</td><td><a asp-page="Details" asp-route-id="@employee.Id">@employee.FullName</a></td><td>@Model.Departments.FirstOrDefault(x => x.Id == employee.DepartmentId)?.Name</td><td>@JalaliDate.Format(employee.HireDate)</td><td>@(employee.Terminated ? "خاتمه یافته" : "فعال")</td></tr>
    }
    </tbody></table>
    <nav aria-label="صفحه‌بندی">
        @if (Model.Result.Page > 1) { <a asp-page="Index" asp-route-query="@Model.Query" asp-route-departmentId="@Model.DepartmentId" asp-route-page="@(Model.Result.Page - 1)">قبلی</a> }
        <span>صفحه @Model.Result.Page</span>
        @if (Model.Result.Page * Model.Result.PageSize < Model.Result.Total) { <a asp-page="Index" asp-route-query="@Model.Query" asp-route-departmentId="@Model.DepartmentId" asp-route-page="@(Model.Result.Page + 1)">بعدی</a> }
    </nav>
}
