@page "/Employees/{id:int}/Edit"
@model HRMS.Next.Pages.Employees.EditModel
@{
    ViewData["Title"] = "ویرایش اطلاعات کارکنان";
}
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <div>
            <h1>ویرایش اطلاعات کارمند</h1>
            <p class="hero-sub">کد پرسنلی @Model.Form.EmployeeNumber</p>
        </div>
        <a asp-page="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> بازگشت به لیست</a>
    </div>
}
<div class="card">
    <div class="card-header bg-primary text-white">ویرایش @Model.Form.FirstName @Model.Form.LastName - کد @Model.Form.EmployeeNumber</div>
    <div class="card-body">
        <form method="post">
            <partial name="_Form" for="Form" />
            <div class="mt-4">
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> ذخیره تغییرات</button>
                <a asp-page="Details" asp-route-id="@RouteData.Values["id"]" class="btn btn-secondary">انصراف</a>
            </div>
        </form>
    </div>
</div>
