@page "/Settings"
@model HRMS.Next.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "تنظیمات سیستم";
}
@section Hero {
    <h1>تنظیمات سیستم</h1>
}
<div class="row g-3">
    <div class="col-md-4 col-lg-3"><a class="text-decoration-none" asp-page="Roles"><div class="card h-100"><div class="card-body text-center"><i class="bi bi-shield-check fs-2 text-primary"></i><h6 class="mt-2 mb-1">نقش‌ها و دسترسی‌ها</h6><span class="small text-muted">مجوزهای نقش در این شرکت</span></div></div></a></div>
    <div class="col-md-4 col-lg-3"><a class="text-decoration-none" asp-page="Users"><div class="card h-100"><div class="card-body text-center"><i class="bi bi-person-gear fs-2 text-primary"></i><h6 class="mt-2 mb-1">حساب‌های کاربری</h6><span class="small text-muted">پیوند پرونده و دسترسی</span></div></div></a></div>
    <div class="col-md-4 col-lg-3"><a class="text-decoration-none" asp-page="OrganizationLinks"><div class="card h-100"><div class="card-body text-center"><i class="bi bi-link-45deg fs-2 text-primary"></i><h6 class="mt-2 mb-1">پیوندهای سازمانی</h6><span class="small text-muted">نشانی‌ها و منابع صفحهٔ اصلی</span></div></div></a></div>
    <div class="col-md-4 col-lg-3"><a class="text-decoration-none" asp-page="Departments"><div class="card h-100"><div class="card-body text-center"><i class="bi bi-diagram-3 fs-2 text-primary"></i><h6 class="mt-2 mb-1">واحدهای سازمانی</h6><span class="small text-muted">ساختار و زیرمجموعه‌ها</span></div></div></a></div>
    <div class="col-md-4 col-lg-3"><a class="text-decoration-none" asp-page="JobTitles"><div class="card h-100"><div class="card-body text-center"><i class="bi bi-briefcase fs-2 text-primary"></i><h6 class="mt-2 mb-1">عناوین شغلی</h6><span class="small text-muted">تعریف نقش‌های سازمان</span></div></div></a></div>
    <div class="col-md-4 col-lg-3"><a class="text-decoration-none" asp-page="/Leave/Index"><div class="card h-100"><div class="card-body text-center"><i class="bi bi-calendar-x fs-2 text-primary"></i><h6 class="mt-2 mb-1">سیاست‌های مرخصی</h6><span class="small text-muted">نوع و سقف ساعت</span></div></div></a></div>
    <div class="col-md-4 col-lg-3"><a class="text-decoration-none" asp-page="/Training/Index"><div class="card h-100"><div class="card-body text-center"><i class="bi bi-mortarboard fs-2 text-primary"></i><h6 class="mt-2 mb-1">دوره‌های آموزشی</h6><span class="small text-muted">کاتالوگ دوره‌ها</span></div></div></a></div>
    <div class="col-md-4 col-lg-3"><a class="text-decoration-none" asp-page="/Reports/Index"><div class="card h-100"><div class="card-body text-center"><i class="bi bi-file-earmark-bar-graph fs-2 text-info"></i><h6 class="mt-2 mb-1">گزارش‌ها</h6><span class="small text-muted">کارکنان و مرخصی</span></div></div></a></div>
</div>
