@page
@model LoginModel
@{
    ViewData["Title"] = "ورود";
}
<div class="card login-card shadow-sm">
    <div class="card-header bg-primary text-white text-center">
        <h5 class="mb-0"><i class="bi bi-shield-lock"></i> ورود به سامانه منابع انسانی</h5>
    </div>
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Username" class="form-label">نام کاربری</label>
                <input asp-for="Username" class="form-control" autocomplete="username" required autofocus dir="ltr" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">رمز عبور</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required dir="ltr" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <input asp-for="ReturnUrl" type="hidden" />
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-left"></i> ورود</button>
        </form>
    </div>
</div>
