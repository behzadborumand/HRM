@{
    var path = Context.Request.Path.Value ?? "";
    var employeesActive = path.StartsWith("/Employees", StringComparison.OrdinalIgnoreCase);
    var leaveActive = path.StartsWith("/Leave", StringComparison.OrdinalIgnoreCase);
    var trainingActive = path.StartsWith("/Training", StringComparison.OrdinalIgnoreCase);
    var authenticated = User.Identity?.IsAuthenticated == true;
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8faf8" />
    <title>@ViewData["Title"] - سامانه منابع انسانی</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(authenticated ? "app-body" : "auth-body")">
    <a class="skip-link" href="#main">رفتن به محتوای اصلی</a>
    <header class="site-header">
        <div class="topbar">
            <a class="brand" asp-page="/Employees/Index" aria-label="سامانه منابع انسانی، صفحه کارکنان">
                <span class="brand-mark" aria-hidden="true">هـ</span>
                <span class="brand-copy"><strong>سامانه منابع انسانی</strong><small>مدیریت یکپارچه کارکنان</small></span>
            </a>
            @if (authenticated)
            {
                <nav class="primary-nav" aria-label="ناوبری اصلی">
                    <a asp-page="/Employees/Index" class="@(employeesActive ? "is-active" : null)" aria-current="@(employeesActive ? "page" : null)">کارکنان</a>
                    <a asp-page="/Leave/Index" class="@(leaveActive ? "is-active" : null)" aria-current="@(leaveActive ? "page" : null)">مرخصی</a>
                    <a asp-page="/Training/Index" class="@(trainingActive ? "is-active" : null)" aria-current="@(trainingActive ? "page" : null)">آموزش</a>
                </nav>
                <div class="account-controls">
                    <span class="account-name" title="@User.Identity?.Name"><span class="account-avatar" aria-hidden="true">ک</span>@User.Identity?.Name</span>
                    <form method="post" asp-page="/Logout"><button class="button-quiet" type="submit">خروج</button></form>
                </div>
            }
        </div>
    </header>
    <main id="main" class="page-shell">
        @RenderBody()
    </main>
    <footer class="site-footer"><span>سامانه منابع انسانی</span><span>مدیریت کارکنان، مرخصی و آموزش</span></footer>
</body>
</html>
