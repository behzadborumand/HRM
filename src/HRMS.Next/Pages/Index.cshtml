@page
@model HRMS.Next.Pages.IndexModel
@{ ViewData["Title"] = "خانه"; }
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <div><h1>سلام @Model.Username، امروز چطور می‌توانم کمکتان کنم؟</h1><p class="hero-sub">دسترسی‌های فعال و پیوندهای سازمانی شما</p></div>
        @if (Model.CanWriteEmployees)
        {
            <a asp-page="/Employees/Create" class="btn btn-hero"><i class="bi bi-person-plus"></i> افزودن کارمند</a>
        }
    </div>
}
<div class="home-workspace">
    <aside class="home-sidebar" aria-label="خلاصهٔ کاربر و پیوندها">
        <section class="card home-profile-card"><div class="card-body d-flex align-items-center gap-3"><span class="avatar avatar-md avatar-fallback" aria-hidden="true"><i class="bi bi-person"></i></span><div class="home-profile-text"><strong>@Model.Username</strong><span>حساب کاربری</span></div></div></section>
        @if (Model.OwnLeave is { } ownLeave)
        {
            <section class="card home-personal-leave">
                <div class="card-header"><h2><i class="bi bi-calendar2-week"></i> مرخصی من</h2><a asp-page="/My/Leave" class="home-header-link">ثبت درخواست</a></div>
                <div class="card-body">
                    <p class="small text-muted">سال مانده: @ownLeave.Year میلادی · ساعت</p>
                    @if (ownLeave.Balances.Count == 0) { <p class="home-empty">مانده‌ای برای این سال ثبت نشده است.</p> }
                    @foreach (var balance in ownLeave.Balances) { <p class="d-flex justify-content-between gap-2"><span>@balance.PolicyName</span><strong>@balance.AvailableHours.ToString("0.##")</strong></p> }
                    <a asp-page="/Employees/Details" asp-route-id="@Model.LinkedEmployeeId" asp-fragment="tab-leave" class="home-header-link">مانده و سوابق درخواست‌ها</a>
                </div>
            </section>
        }
        @if (Model.Highlights is { } home)
        {
            <section class="card home-availability">
                <div class="card-header"><h2><i class="bi bi-person-dash"></i> مرخصی همکاران</h2></div>
                <div class="card-body">
                    <ul class="nav nav-pills home-day-tabs" role="tablist" aria-label="روزهای مرخصی">
                        @for (var i = 0; i < home.AbsenceDays.Count; i++)
                        {
                            <li class="nav-item" role="presentation"><button class="nav-link @(i == 0 ? "active" : "")" id="home-day-tab-@i" data-bs-toggle="tab" data-bs-target="#home-day-@i" type="button" role="tab" aria-controls="home-day-@i" aria-selected="@(i == 0 ? "true" : "false")">@home.AbsenceDays[i].Caption</button></li>
                        }
                    </ul>
                    <div class="tab-content">
                        @for (var i = 0; i < home.AbsenceDays.Count; i++)
                        {
                            var day = home.AbsenceDays[i];
                            <div class="tab-pane @(i == 0 ? "show active" : "")" id="home-day-@i" role="tabpanel" aria-labelledby="home-day-tab-@i">
                                <p class="home-day-date">@HRMS.Next.Pages.Employees.JalaliDate.Format(day.Date)</p>
                                @if (day.People.Count == 0) { <p class="home-empty">مرخصی تأییدشده‌ای برای این روز ثبت نشده است.</p> }
                                @foreach (var person in day.People)
                                {
                                    <a asp-page="/Employees/Details" asp-route-id="@person.EmployeeId" class="home-absent-person"><i class="bi bi-person-circle"></i><span>@person.FullName<small>@person.DepartmentName</small></span></a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        }        <section class="card home-organization-links">
            <div class="card-header"><h2><i class="bi bi-link-45deg"></i> پیوندهای سازمانی</h2>
                @if (Model.IsAdmin) { <a asp-page="/Settings/OrganizationLinks" class="home-header-link">مدیریت پیوندها</a> }
            </div>
            <div class="card-body">
                @if (Model.OrganizationLinks.Count == 0)
                {
                    <p class="home-empty">هنوز پیوند فعالی برای سازمان ثبت نشده است.</p>
                }
                @foreach (var link in Model.OrganizationLinks)
                {
                    <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="home-person-row"><i class="bi bi-box-arrow-up-left" aria-hidden="true"></i><span><strong>@link.Title</strong>@if (!string.IsNullOrWhiteSpace(link.Description)) { <small>@link.Description</small> }</span><span class="visually-hidden">(در زبانهٔ جدید)</span></a>
                }
            </div>
        </section>
    </aside>
    <div class="home-content">
        <section class="card home-shortcut-card" aria-labelledby="shortcuts-title">
            <div class="card-header"><h2 id="shortcuts-title"><i class="bi bi-grid"></i> دسترسی سریع</h2><span class="small text-muted">کارهای پرتکرار شما</span></div>
            <div class="card-body"><div class="home-shortcuts">
                @if (Model.LinkedEmployeeId is { } ownId)
                {
                    <a asp-page="/MyInfo" class="home-shortcut"><i class="bi bi-person-vcard"></i><span><strong>اطلاعات من</strong><small>پرونده و مدارک شخصی</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                    <a asp-page="/My/Personal" class="home-shortcut"><i class="bi bi-person-gear"></i><span><strong>اطلاعات تماس من</strong><small>نشانی و مخاطب اضطراری</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                    <a asp-page="/My/Leave" class="home-shortcut"><i class="bi bi-calendar-plus"></i><span><strong>مرخصی من</strong><small>ثبت و لغو درخواست</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                    <a asp-page="/Employees/Details" asp-route-id="@ownId" asp-fragment="tab-training" class="home-shortcut"><i class="bi bi-mortarboard"></i><span><strong>آموزش‌های من</strong><small>دوره‌ها و سررسیدها</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                }
                @if (Model.CanUseTeam)
                {
                    <a asp-page="/Team/Index" class="home-shortcut"><i class="bi bi-people"></i><span><strong>تیم من</strong><small>همکاران تحت مدیریت مستقیم</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                    <a asp-page="/Team/Leave" class="home-shortcut"><i class="bi bi-calendar-check"></i><span><strong>مرخصی تیم</strong><small>بررسی درخواست‌های در انتظار</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                }
                @if (Model.CanBrowsePeople)
                {
                    <a asp-page="/Employees/Index" class="home-shortcut"><i class="bi bi-people"></i><span><strong>کارکنان</strong><small>جستجو و مشاهدهٔ پرونده‌ها</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                }
                @if (Model.IsAdmin)
                {
                    <a asp-page="/Leave/Index" class="home-shortcut"><i class="bi bi-calendar-check"></i><span><strong>مرخصی</strong><small>درخواست‌ها و سیاست‌ها</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                    <a asp-page="/Training/Index" class="home-shortcut"><i class="bi bi-mortarboard"></i><span><strong>آموزش‌ها</strong><small>دوره‌ها و واگذاری‌ها</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                    <a asp-page="/Reports/Index" class="home-shortcut"><i class="bi bi-file-earmark-bar-graph"></i><span><strong>گزارش‌ها</strong><small>کارکنان و مرخصی</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                    <a asp-page="/Settings/Index" class="home-shortcut"><i class="bi bi-gear"></i><span><strong>تنظیمات</strong><small>ساختار و پیوندهای سازمانی</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                }
            </div></div>
        </section>
        @if (Model.Highlights is { } homeContent)
        {
            <section class="card home-new-hires">
                <div class="card-header"><h2><i class="bi bi-person-plus"></i> به همکاران تازه‌وارد خوش آمد می‌گوییم</h2><span class="small text-muted">۳۰ روز گذشته</span></div>
                <div class="card-body">
                    @if (homeContent.NewHires.Count == 0) { <p class="home-empty">در ۳۰ روز گذشته همکار تازه‌ای به سازمان نپیوسته است.</p> }
                    <div class="home-new-hires-list">
                        @foreach (var person in homeContent.NewHires)
                        {
                            <a asp-page="/Employees/Details" asp-route-id="@person.EmployeeId" class="home-person-row"><span class="avatar avatar-fallback" aria-hidden="true"><i class="bi bi-person"></i></span><span><strong>@person.FullName</strong><small>@person.DepartmentName</small><small>شروع همکاری: @HRMS.Next.Pages.Employees.JalaliDate.Format(person.HireDate)</small></span></a>
                        }
                    </div>
                </div>
            </section>
            @if (Model.IsAdmin && homeContent.PendingRequests.Count > 0)
            {
                <section class="card home-approvals">
                    <div class="card-header"><h2><i class="bi bi-check2-circle"></i> منتظر تصمیم شما</h2><a asp-page="/Leave/Index" class="btn btn-sm btn-outline-primary">رفتن به صف تأیید</a></div>
                    <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>کارمند</th><th>نوع</th><th>از</th><th>ساعت</th></tr></thead><tbody>
                    @foreach (var request in homeContent.PendingRequests)
                    {
                        <tr><td>@request.EmployeeName</td><td>@request.PolicyName</td><td>@HRMS.Next.Pages.Employees.JalaliDate.Format(request.StartDate)</td><td>@request.Hours.ToString("0.##")</td></tr>
                    }
                    </tbody></table></div>
                </section>
            }
        }
        @if (Model.Stats is { } stats)
        {
            <section class="home-organization" aria-labelledby="organization-title">
                <div class="home-section-heading"><h2 id="organization-title">نمای سازمان</h2><a asp-page="/Reports/Index">همهٔ گزارش‌ها <i class="bi bi-chevron-left"></i></a></div>
                <div class="row g-3">
                    <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><h5 class="card-title text-muted"><i class="bi bi-people text-primary"></i> کل کارکنان</h5><p class="stat-value">@stats.TotalEmployees</p><a asp-page="/Reports/Employees">مشاهده لیست</a></div></div></div>
                    <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><h5 class="card-title text-muted"><i class="bi bi-person-check text-primary"></i> فعال</h5><p class="stat-value">@stats.ActiveEmployees</p><span class="small text-muted">در مرخصی: @stats.OnLeaveEmployees</span></div></div></div>
                    <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><h5 class="card-title text-muted"><i class="bi bi-calendar-event text-primary"></i> درخواست در انتظار</h5><p class="stat-value">@stats.PendingRequests</p><a asp-page="/Leave/Index">بررسی درخواست‌ها</a></div></div></div>
                    <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><h5 class="card-title text-muted"><i class="bi bi-diagram-3 text-primary"></i> واحدهای سازمانی</h5><p class="stat-value">@stats.DepartmentCount</p><a asp-page="/Reports/Index">مشاهده گزارش‌ها</a></div></div></div>
                </div>
            </section>
        }
    </div>
</div>
