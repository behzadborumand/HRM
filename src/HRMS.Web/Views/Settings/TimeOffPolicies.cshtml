@model PolicyAdminViewModel
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <h1>سیاست‌های مرخصی</h1>
        <a asp-action="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> تنظیمات</a>
    </div>
}

<div class="alert alert-light border small">
    ساعت تعلق‌گرفته هر سیاست بر اساس تقویم میلادی و به‌صورت نسبی با سابقه کار محاسبه می‌شود. مقدار ۰ یعنی بدون سقف.
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <table class="table table-striped align-middle text-center mb-0">
                    <thead><tr><th>نام سیاست</th><th>دسته‌بندی</th><th>سقف سالانه</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                    <tbody>
                        @foreach (var policy in Model.Policies)
                        {
                            <tr>
                                <td class="fw-semibold">@policy.PolicyName</td>
                                <td>@FaLabels.PolicyCategory(policy.Category)</td>
                                <td>@(policy.AnnualHours > 0 ? $"{PersianDate.ToPersianDigits(policy.AnnualHours.ToString("0.##"))} ساعت" : "بدون سقف")</td>
                                <td>
                                    <span class="badge text-bg-@(policy.Active ? "success" : "secondary")">@(policy.Active ? "فعال" : "غیرفعال")</span>
                                </td>
                                <td>
                                    <a asp-action="TimeOffPolicies" asp-route-edit="@policy.PolicyId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                    @if (User.HasPermission(Permissions.OrgWrite))
                                    {
                                        <form asp-action="DeletePolicy" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@policy.PolicyId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('این سیاست حذف شود؟');"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (User.HasPermission(Permissions.OrgWrite))
    {
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header bg-primary text-white">@(Model.IsEdit ? "ویرایش سیاست" : "افزودن سیاست مرخصی")</div>
                <div class="card-body">
                    <form asp-action="TimeOffPolicies" method="post">
                        @if (Model.IsEdit)
                        {
                            <input type="hidden" asp-for="PolicyId" />
                        }
                        <div class="mb-3">
                            <label asp-for="PolicyName" class="form-label"></label>
                            <input asp-for="PolicyName" class="form-control" />
                            <span asp-validation-for="PolicyName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="Vacation">استحقاقی</option>
                                <option value="Sick">استعلاجی</option>
                                <option value="Unpaid">بدون حقوق</option>
                                <option value="Special">ویژه</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="AnnualHours" class="form-label"></label>
                            <input asp-for="AnnualHours" class="form-control" dir="ltr" />
                            <span asp-validation-for="AnnualHours" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input asp-for="Active" class="form-check-input" />
                            <label asp-for="Active" class="form-check-label"></label>
                        </div>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> ذخیره</button>
                        <a asp-action="TimeOffPolicies" class="btn btn-light">انصراف</a>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
