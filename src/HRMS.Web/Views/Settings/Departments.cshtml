@model DepartmentAdminViewModel
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <h1>واحدهای سازمانی</h1>
        <a asp-action="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> تنظیمات</a>
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white fw-semibold">لیست واحدها</div>
            <div class="card-body">
                <table class="table table-striped align-middle text-center mb-0">
                    <thead>
                        <tr><th>نام واحد</th><th>واحد بالادستی</th><th>کارمند</th><th>عملیات</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr><td colspan="4" class="text-muted">واحدی ثبت نشده است.</td></tr>
                        }
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="fw-semibold">@row.DepartmentName</td>
                                <td>@(row.ParentName ?? "-")</td>
                                <td>@PersianDate.ToPersianDigits(row.Headcount.ToString())</td>
                                <td>
                                    <a asp-action="Departments" asp-route-edit="@row.DepartmentId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                    @if (User.HasPermission(Permissions.OrgWrite))
                                    {
                                        <form asp-action="DeleteDepartment" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@row.DepartmentId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('این واحد حذف شود؟');"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (User.HasPermission(Permissions.OrgWrite))
    {
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header bg-primary text-white">@(Model.IsEdit ? "ویرایش واحد" : "افزودن واحد سازمانی")</div>
                <div class="card-body">
                    <form asp-action="Departments" method="post">
                        @if (Model.IsEdit)
                        {
                            <input type="hidden" asp-for="DepartmentId" />
                        }
                        <div class="mb-3">
                            <label asp-for="DepartmentName" class="form-label"></label>
                            <input asp-for="DepartmentName" class="form-control" />
                            <span asp-validation-for="DepartmentName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ParentDepartmentId" class="form-label"></label>
                            <select asp-for="ParentDepartmentId" class="form-select"
                                    asp-items="@(new SelectList(Model.Options.Where(o => o.DepartmentId != Model.DepartmentId), "DepartmentId", "DepartmentName"))">
                                <option value="">بدون بالادست</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> ذخیره</button>
                        <a asp-action="Departments" class="btn btn-light">انصراف</a>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
