@model EmployeeDetailsViewModel
@{
    var profile = Model.Profile;
    var canWrite = User.HasPermission(Permissions.EmployeesWrite);
    var canManagePhoto = canWrite || User.EmployeeId() == profile.EmployeeId;
    var canViewPay = canWrite || User.EmployeeId() == profile.EmployeeId;
}
@section Hero {
    <div class="profile-hero">
        <div class="profile-hero-avatar">
            @if (Model.Profile.HasPhoto)
            {
                <img src="/Employees/Photo/@Model.Profile.EmployeeId?v=@Model.Profile.ModifiedDate.ToString("yyyyMMddHHmmss")" alt="تصویر @Model.Profile.FullName" class="avatar avatar-lg" />
            }
            else
            {
                <span class="avatar avatar-lg avatar-fallback" aria-hidden="true">@(Model.Profile.FirstName.Length > 0 ? Model.Profile.FirstName[..1] : "?")</span>
            }
        </div>
        <div class="profile-heading">
            <h1>@Model.Profile.FullName</h1>
            <p class="hero-sub">
                @(Model.Profile.JobTitleName ?? "بدون عنوان شغلی")
                @if (Model.Profile.DepartmentName is not null)
                {
                    <text> - @Model.Profile.DepartmentName</text>
                }
                @if (Model.Profile.EmployeeNumber is not null)
                {
                    <text> | کد پرسنلی @Model.Profile.EmployeeNumber</text>
                }
            </p>
            <span class="badge text-bg-@FaLabels.EmploymentStatusBadge(Model.Profile.EmploymentStatus) mt-1">@FaLabels.EmploymentStatus(Model.Profile.EmploymentStatus)</span>
        </div>
        <div class="profile-hero-actions">
            @if (Model.Neighbours is not null)
            {
                <div class="mb-2 small">
                    @if (Model.Neighbours.PreviousEmployeeId is not null)
                    {
                        <a asp-action="Details" asp-route-id="@Model.Neighbours.PreviousEmployeeId" class="btn btn-hero btn-sm"><i class="bi bi-chevron-right"></i> قبلی</a>
                    }
                    <span class="mx-2">@PersianDate.ToPersianDigits(Model.Neighbours.Position.ToString()) از @PersianDate.ToPersianDigits(Model.Neighbours.Total.ToString())</span>
                    @if (Model.Neighbours.NextEmployeeId is not null)
                    {
                        <a asp-action="Details" asp-route-id="@Model.Neighbours.NextEmployeeId" class="btn btn-hero btn-sm">بعدی <i class="bi bi-chevron-left"></i></a>
                    }
                </div>
            }
            <div class="d-flex gap-2 justify-content-end">
                @if (canWrite)
                {
                    <a asp-action="Edit" asp-route-id="@profile.EmployeeId" class="btn btn-hero btn-sm"><i class="bi bi-pencil"></i> ویرایش پرونده</a>
                }
                <a asp-action="Index" class="btn btn-hero btn-sm" aria-label="بازگشت به لیست کارکنان"><i class="bi bi-grid"></i></a>
            </div>
        </div>
    </div>
    <nav class="profile-tabs" aria-label="بخش‌های پرونده کارمند">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-personal" type="button" role="tab">اطلاعات شخصی</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-job" type="button" role="tab">شغل</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-timeoff" type="button" role="tab">مرخصی</button></li>
            @if (User.HasPermission(Permissions.EmployeesWrite) || User.EmployeeId() == Model.Profile.EmployeeId)
            {
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-pay" type="button" role="tab">اطلاعات حقوق</button></li>
            }
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-emergency" type="button" role="tab">اضطراری</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-documents" type="button" role="tab">مدارک</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-training" type="button" role="tab">آموزش‌ها</button></li>
        </ul>
    </nav>
}

<div class="employee-workspace">
    <aside class="employee-sidebar">
        <div class="card profile-aside">
            <div class="card-body">
                @if (canManagePhoto)
                {
                    <details class="photo-editor">
                        <summary><i class="bi bi-camera"></i> تغییر تصویر</summary>
                        <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" class="mt-2">
                            <input type="hidden" name="employeeId" value="@profile.EmployeeId" />
                            <label class="form-label small text-muted" for="photoFile">تصویر جدید</label>
                            <input class="form-control form-control-sm" id="photoFile" name="file" type="file"
                                   accept=".jpg,.jpeg,.png,.gif,.webp" required />
                            <button type="submit" class="btn btn-sm btn-primary mt-2"><i class="bi bi-upload"></i> بارگذاری</button>
                            <div class="small text-muted mt-1">JPEG، PNG، GIF یا WebP تا ۲ مگابایت</div>
                        </form>

                        @if (profile.HasPhoto)
                        {
                            <form asp-action="DeletePhoto" method="post" class="mt-1">
                                <input type="hidden" name="employeeId" value="@profile.EmployeeId" />
                                <button type="submit" class="btn btn-sm btn-link text-danger p-0"><i class="bi bi-trash"></i> حذف تصویر</button>
                            </form>
                        }
                    </details>
                }

                <p class="aside-label">تلفن و ایمیل</p>
                <p class="aside-value" dir="ltr">@(profile.MobilePhone ?? profile.Phone ?? "-")<br />@(profile.Email ?? "-")</p>

                <p class="aside-label">تاریخ استخدام</p>
                <p class="aside-value">@PersianDate.ToJalali(profile.HireDate)<br /><span class="text-muted">@PersianDate.ToJalaliDuration(profile.HireDate, DateTime.Today)</span></p>

                <p class="aside-label">کد پرسنلی</p>
                <p class="aside-value">@(profile.EmployeeNumber ?? "-")</p>

                <p class="aside-label">وضعیت استخدام</p>
                <p class="aside-value">@FaLabels.EmploymentType(profile.EmploymentType)</p>

                <p class="aside-label">واحد سازمانی</p>
                <p class="aside-value">@(profile.DepartmentName ?? "-")</p>

                <p class="aside-label">مدیر مستقیم</p>
                <p class="aside-value">
                    @if (profile.ManagerId is null)
                    {
                        <text>-</text>
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-id="@profile.ManagerId">@profile.ManagerName</a>
                    }
                </p>

                <p class="aside-label">زیردستان (@PersianDate.ToPersianDigits(Model.DirectReports.Count.ToString()))</p>
                @if (Model.DirectReports.Count == 0)
                {
                    <p class="aside-value text-muted small">کارمندی مستقیماً به این شخص گزارش نمی‌دهد.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var report in Model.DirectReports)
                        {
                            <li class="mb-1">
                                <a asp-action="Details" asp-route-id="@report.EmployeeId">@report.FullName</a>
                                <div class="small text-muted">@report.JobTitleName</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </aside>

    <div class="employee-content">
        <div class="tab-content">
            <div class="tab-pane fade" id="tab-personal" role="tabpanel">
                <div class="card mb-3">
                    <div class="card-header bg-white fw-semibold"><i class="bi bi-person-lines-fill"></i> راه‌های ارتباطی</div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-5">ایمیل</dt><dd class="col-7" dir="ltr">@(profile.Email ?? "-")</dd>
                            <dt class="col-5">تلفن</dt><dd class="col-7" dir="ltr">@(profile.Phone ?? "-")</dd>
                            <dt class="col-5">تلفن همراه</dt><dd class="col-7" dir="ltr">@(profile.MobilePhone ?? "-")</dd>
                            <dt class="col-5">تلفن منزل</dt><dd class="col-7" dir="ltr">@(profile.HomePhone ?? "-")</dd>
                            <dt class="col-5">تاریخ تولد</dt><dd class="col-7">@PersianDate.ToJalaliWithGregorian(profile.DateOfBirth)</dd>
                            <dt class="col-5">جنسیت</dt><dd class="col-7">@FaLabels.Gender(profile.Gender)</dd>
                            <dt class="col-5">وضعیت تاهل</dt><dd class="col-7">@FaLabels.MaritalStatus(profile.MaritalStatus)</dd>
                        </dl>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-white fw-semibold"><i class="bi bi-geo-alt"></i> نشانی</div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-5">نشانی</dt><dd class="col-7">@(profile.AddressLine1 ?? "-")</dd>
                            <dt class="col-5">شهر</dt><dd class="col-7">@(profile.City ?? "-")</dd>
                            <dt class="col-5">استان</dt><dd class="col-7">@(profile.State ?? "-")</dd>
                            <dt class="col-5">کشور</dt><dd class="col-7">@(profile.Country ?? "-")</dd>
                            <dt class="col-5">کدپستی</dt><dd class="col-7" dir="ltr">@(profile.PostalCode ?? "-")</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade show active" id="tab-job" role="tabpanel">
                <h2 class="profile-page-title"><i class="bi bi-briefcase-fill"></i> شغل</h2>
                <div class="card mb-3">
                    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-person-badge"></i> وضعیت استخدام</span>
                        @if (canWrite)
                        {
                            <a asp-action="Edit" asp-route-id="@profile.EmployeeId" class="profile-update-link"><i class="bi bi-plus-circle-fill"></i> به‌روزرسانی وضعیت استخدام</a>
                        }
                    </div>
                    <div class="card-body table-responsive">
                        <table class="table align-middle">
                            <thead><tr><th>تاریخ استخدام</th><th>وضعیت اشتغال</th><th>نوع استخدام</th><th>تاریخ خروج</th></tr></thead>
                            <tbody><tr class="profile-current-row"><td>@PersianDate.ToJalali(profile.HireDate)</td><td>@FaLabels.EmploymentStatus(profile.EmploymentStatus)</td><td>@FaLabels.EmploymentType(profile.EmploymentType)</td><td>@PersianDate.ToJalali(profile.TerminationDate)</td></tr></tbody>
                        </table>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-briefcase-fill"></i> اطلاعات و سوابق شغلی</span>
                        @if (canWrite)
                        {
                            <a asp-action="Edit" asp-route-id="@profile.EmployeeId" class="profile-update-link"><i class="bi bi-plus-circle-fill"></i> به‌روزرسانی اطلاعات شغل</a>
                        }
                    </div>
                    <div class="card-body table-responsive">
                        <table class="table table-sm align-middle text-center mb-0">
                            <thead>
                                <tr><th>از</th><th>تا</th><th>وضعیت</th><th>واحد</th><th>عنوان شغلی</th><th>مدیر</th></tr>
                            </thead>
                            <tbody>
                                @if (Model.JobHistory.Count == 0)
                                {
                                    <tr><td colspan="6" class="text-muted">سابقه شغلی ثبت نشده است.</td></tr>
                                }
                                @foreach (var job in Model.JobHistory)
                                {
                                    <tr class="@(job.IsCurrent ? "fw-semibold profile-current-row" : null)">
                                        <td>@PersianDate.ToJalali(job.StartDate)@(job.IsCurrent ? " *" : null)</td>
                                        <td>@PersianDate.ToJalali(job.EndDate)</td>
                                        <td>@FaLabels.EmploymentType(job.EmploymentType)</td>
                                        <td>@(job.DepartmentName ?? "-")</td>
                                        <td>@(job.JobTitleName ?? "-")</td>
                                        <td>@(job.ManagerName ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="form-text">* ردیف جاری</div>
                    </div>
                </div>

                @if (canWrite && profile.EmploymentStatus != "Terminated")
                {
                    <details class="employment-actions mt-4">
                        <summary>مدیریت خروج از سازمان</summary>
                        <div class="card-header bg-white fw-semibold text-warning"><i class="bi bi-box-arrow-right"></i> خروج از سازمان</div>
                        <div class="card-body">
                            <form asp-action="Terminate" method="post" class="d-flex gap-2 align-items-end flex-wrap">
                                <input type="hidden" name="id" value="@profile.EmployeeId" />
                                <div>
                                    <label class="form-label" for="terminationDate">تاریخ خروج</label>
                                    <input class="form-control" type="text" id="terminationDate" name="terminationDate" dir="ltr" autocomplete="off"
                                           placeholder="۱۴۰۵/۰۸/۱۲" value="@PersianDate.ToJalaliInput(DateTime.Today)" required />
                                </div>
                                <button type="submit" class="btn btn-outline-warning"><i class="bi bi-exclamation-triangle"></i> ثبت خروج و بستن شغل</button>
                            </form>
                            <div class="form-text mt-2">با ثبت خروج، شغل فعلی بسته می‌شود و در سوابق مرخصی نگهداری می‌گردد.</div>
                        </div>
                    </details>
                }

                @if (User.HasPermission(Permissions.EmployeesDelete))
                {
                    <details class="employment-actions mt-3">
                    <summary>حذف رکورد کارمند</summary>
                    <form asp-action="Delete" method="post" class="mt-3"
                          onsubmit="return confirm('حذف این کارمند و سوابق مرخصی آن قطعی است؛ ادامه می‌دهید؟');">
                        <input type="hidden" name="id" value="@profile.EmployeeId" />
                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> حذف کامل رکورد کارمند</button>
                    </form>
                    </details>
                }
            </div>

            @if (canViewPay)
            {
                <div class="tab-pane fade" id="tab-pay" role="tabpanel">
                    <h2 class="profile-page-title"><i class="bi bi-cash-coin"></i> اطلاعات حقوق</h2>
                    <section class="card mb-3">
                        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-cash-coin"></i> اطلاعات حقوق</span>
                            @if (canWrite)
                            {
                                <a asp-action="Edit" asp-route-id="@profile.EmployeeId" class="btn btn-sm btn-outline-primary">به‌روزرسانی اطلاعات حقوق</a>
                            }
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">نوع حقوق</dt><dd class="col-sm-8">@FaLabels.PayType(profile.PayType)</dd>
                                <dt class="col-sm-4">نرخ ثبت‌شده</dt><dd class="col-sm-8 fw-semibold">@PersianDate.ToPersianDigits(profile.PayRate?.ToString("N0") ?? "-")</dd>
                            </dl>
                            <p class="small text-muted mb-0">واحد پول و دورهٔ پرداخت در داده‌های فعلی ثبت نشده‌اند. این نرخ، مبلغ خالص دریافتی یا فیش حقوقی نیست.</p>
                        </div>
                    </section>
                    <section class="card">
                        <div class="card-header fw-semibold"><i class="bi bi-clock-history"></i> سابقه نرخ حقوق</div>
                        <div class="card-body table-responsive p-0">
                            <table class="table table-sm align-middle mb-0">
                                <thead><tr><th>تاریخ شروع</th><th>تاریخ پایان</th><th>نوع حقوق</th><th>نرخ ثبت‌شده</th></tr></thead>
                                <tbody>
                                    @if (Model.JobHistory.Count == 0)
                                    {
                                        <tr><td colspan="4" class="text-muted">سابقه‌ای ثبت نشده است.</td></tr>
                                    }
                                    @foreach (var job in Model.JobHistory)
                                    {
                                        <tr class="@(job.IsCurrent ? "profile-current-row" : null)">
                                            <td>@PersianDate.ToJalali(job.StartDate)</td>
                                            <td>@PersianDate.ToJalali(job.EndDate)</td>
                                            <td>@FaLabels.PayType(job.PayType)</td>
                                            <td>@PersianDate.ToPersianDigits(job.PayRate?.ToString("N0") ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
            }

            <div class="tab-pane fade" id="tab-timeoff" role="tabpanel">
                <div class="card mb-3">
                    <div class="card-header bg-white fw-semibold"><i class="bi bi-calendar-week"></i> مانده مرخصی @PersianDate.ToPersianDigits(DateTime.Now.Year.ToString())</div>
                    <div class="card-body">
                        @if (Model.Balances.Count == 0)
                        {
                            <p class="text-muted mb-0">مانده‌ای برای این کارمند ساخته نشده است.</p>
                        }
                        else
                        {
                            <div class="row g-2">
                                @foreach (var balance in Model.Balances)
                                {
                                    <div class="col-md-6">
                                        <div class="border rounded p-2 h-100">
                                            <div class="d-flex justify-content-between">
                                                <span class="fw-semibold">@balance.PolicyName</span>
                                                <span class="badge text-bg-light">@FaLabels.PolicyCategory(balance.Category)</span>
                                            </div>
                                            <div class="small text-muted mt-1">
                                                تعلق گرفته: @PersianDate.ToPersianDigits($"{balance.AccruedHours:0.##}") ساعت -
                                                استفاده شده: @PersianDate.ToPersianDigits($"{balance.UsedHours:0.##}") ساعت -
                                                در انتظار: @PersianDate.ToPersianDigits($"{balance.PendingHours:0.##}") ساعت
                                            </div>
                                            <div class="fs-5 @(balance.Unlimited || balance.AvailableHours >= 0 ? "text-success" : "text-danger")">
                                                @(balance.Unlimited ? "بدون سقف" : $"{PersianDate.ToPersianDigits(balance.AvailableHours.ToString("0.##"))} ساعت مانده")
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-white fw-semibold"><i class="bi bi-calendar-x"></i> تاریخچه مرخصی</div>
                    <div class="card-body table-responsive">
                        <table class="table table-sm table-striped text-center align-middle mb-0">
                            <thead>
                                <tr><th>نوع مرخصی</th><th>از</th><th>تا</th><th>ساعت</th><th>وضعیت</th><th>توضیح</th></tr>
                            </thead>
                            <tbody>
                                @if (Model.Requests.Count == 0)
                                {
                                    <tr><td colspan="6" class="text-muted">درخواستی ثبت نشده است.</td></tr>
                                }
                                @foreach (var request in Model.Requests)
                                {
                                    <tr>
                                        <td>@request.PolicyName</td>
                                        <td>@PersianDate.ToJalali(request.StartDate)</td>
                                        <td>@PersianDate.ToJalali(request.EndDate)</td>
                                        <td>@PersianDate.ToPersianDigits($"{request.TotalHours:0.##}")</td>
                                        <td><span class="badge text-bg-@FaLabels.RequestStatusBadge(request.Status)">@FaLabels.RequestStatus(request.Status)</span></td>
                                        <td class="text-muted small">@(request.Comments ?? request.Reason ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-emergency" role="tabpanel">
                <div class="card">
                    <div class="card-header bg-white fw-semibold"><i class="bi bi-heart-pulse"></i> مخاطب اضطراری</div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-5">نام</dt><dd class="col-7">@(profile.EmergencyContactName ?? "-")</dd>
                            <dt class="col-5">نسبت</dt><dd class="col-7">@(profile.EmergencyContactRelation ?? "-")</dd>
                            <dt class="col-5">تماس</dt><dd class="col-7" dir="ltr">@(profile.EmergencyContactPhone ?? "-")</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-documents" role="tabpanel">
                <div class="card">
                    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-folder2-open"></i> مدارک (@PersianDate.ToPersianDigits(Model.Documents.Count.ToString()))</span>
                        @if (canWrite)
                        {
                            <a asp-controller="Documents" asp-action="Index" asp-route-employeeId="@profile.EmployeeId" class="btn btn-sm btn-outline-primary">بارگذاری یا حذف سند</a>
                        }
                    </div>
                    <div class="card-body table-responsive">
                        <table class="table table-sm table-striped align-middle text-center mb-0">
                            <thead>
                                <tr><th>عنوان</th><th>دسته</th><th>حجم</th><th>بارگذاری</th><th>انقضا</th><th></th></tr>
                            </thead>
                            <tbody>
                                @if (Model.Documents.Count == 0)
                                {
                                    <tr><td colspan="6" class="text-muted">سندی برای این کارمند ثبت نشده است.</td></tr>
                                }
                                @foreach (var document in Model.Documents)
                                {
                                    <tr>
                                        <td class="text-start">@document.Title</td>
                                        <td>@(string.IsNullOrWhiteSpace(document.Category) ? "-" : document.Category)</td>
                                        <td>@PersianDate.ToPersianDigits($"{document.FileSize / 1024.0:0.#}") کیلوبایت</td>
                                        <td>@PersianDate.ToJalali(document.UploadDate)</td>
                                        <td>@PersianDate.ToJalali(document.ExpiryDate)</td>
                                        <td>
                                            <a asp-controller="Documents" asp-action="Download" asp-route-id="@document.DocumentId" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-download"></i> دانلود
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-training" role="tabpanel">
                <div class="card">
                    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-mortarboard"></i> آموزش‌ها (@PersianDate.ToPersianDigits(Model.Trainings.Count.ToString()))</span>
                        <a asp-controller="Training" asp-action="Index" asp-route-employeeId="@profile.EmployeeId" class="btn btn-sm btn-outline-primary">
                            واگذاری یا ثبت انجام
                        </a>
                    </div>
                    <div class="card-body table-responsive">
                        <table class="table table-sm table-striped align-middle text-center mb-0">
                            <thead>
                                <tr><th>دوره</th><th>واگذاری</th><th>سررسید</th><th>وضعیت</th><th>انجام</th><th>مدرک</th></tr>
                            </thead>
                            <tbody>
                                @if (Model.Trainings.Count == 0)
                                {
                                    <tr><td colspan="6" class="text-muted">آموزشی برای این کارمند ثبت نشده است.</td></tr>
                                }
                                @foreach (var training in Model.Trainings)
                                {
                                    <tr>
                                        <td class="text-start">
                                            @training.CourseTitle
                                            @if (training.CourseCategory is not null)
                                            {
                                                <div class="small text-muted">@training.CourseCategory</div>
                                            }
                                        </td>
                                        <td>@PersianDate.ToJalali(training.AssignedDate)</td>
                                        <td>
                                            @(training.DueDate is null ? "-" : PersianDate.ToJalali(training.DueDate))
                                            <div class="small @(training.DaysRemaining is < 0 ? "text-danger" : "text-muted")">@FaLabels.TrainingDueHint(training.DaysRemaining)</div>
                                        </td>
                                        <td><span class="badge text-bg-@FaLabels.TrainingStatusBadge(training.Status)">@FaLabels.TrainingStatus(training.Status)</span></td>
                                        <td>@(training.CompletedDate is null ? "-" : PersianDate.ToJalali(training.CompletedDate))</td>
                                        <td class="small" dir="ltr">@(training.CertificateNumber ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
