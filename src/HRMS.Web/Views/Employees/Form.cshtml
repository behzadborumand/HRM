@model EmployeeFormViewModel
@{
    var isEdit = !Model.IsNew;
    ViewData["Title"] = isEdit ? "ویرایش اطلاعات کارکنان" : "افزودن کارکنان جدید";
}
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <div>
            <h1>@(Model.IsNew ? "افزودن کارمند جدید" : "ویرایش اطلاعات کارمند")</h1>
            @if (!Model.IsNew)
            {
                <p class="hero-sub">کد پرسنلی @Model.EmployeeNumber</p>
            }
        </div>
        <a asp-action="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> بازگشت به لیست</a>
    </div>
}

<div class="card">
    <div class="card-header bg-primary text-white">
        @(isEdit ? $"ویرایش {Model.FirstName} {Model.LastName} - کد {@Model.EmployeeId}" : "اطلاعات شخصی، شغلی و نشانی")
    </div>
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
            @if (isEdit)
            {
                <input type="hidden" asp-for="EmployeeId" />
            }
            <partial name="_Form" model="Model" />
            <div class="mt-4">
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> @(isEdit ? "ذخیره تغییرات" : "ثبت کارمند")</button>
                <a asp-action="Index" class="btn btn-secondary">انصراف</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
