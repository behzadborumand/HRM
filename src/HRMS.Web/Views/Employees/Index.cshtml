@model EmployeeIndexViewModel
@functions {
    // The stamp is the employee's ModifiedDate, which the photo actions refresh, so a replaced image is a new URL.
    static string PhotoHref(int employeeId, DateTime stamp) => $"/Employees/Photo/{employeeId}?v={stamp:yyyyMMddHHmmss}";
}
@{
    var canWrite = User.HasPermission(Permissions.EmployeesWrite);
    var routeData = new Dictionary<string, string>
    {
        ["keyword"] = Model.Keyword ?? string.Empty,
        ["departmentId"] = Model.DepartmentId?.ToString() ?? string.Empty,
        ["status"] = Model.Status ?? string.Empty
    };
}
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <div>
            <h1>لیست کارکنان</h1>
            <p class="hero-sub">جستجو، فیلتر و ویرایش گروهی کارکنان</p>
        </div>
        @if (User.HasPermission(Permissions.EmployeesWrite))
        {
            <a asp-action="Create" class="btn btn-hero"><i class="bi bi-person-plus"></i> افزودن کارمند</a>
        }
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="keyword">جستجو</label>
                <input type="search" class="form-control" id="keyword" name="keyword" value="@Model.Keyword"
                       placeholder="نام، کد پرسنلی، ایمیل یا تلفن" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="departmentId">واحد سازمانی</label>
                <select class="form-select" id="departmentId" name="departmentId" asp-items="@(new SelectList(Model.Departments, "DepartmentId", "DepartmentName", Model.DepartmentId))">
                    <option value="">همه واحدها</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="status">وضعیت اشتغال</label>
                <select class="form-select" id="status" name="status">
                    <option value="">همه وضعیت‌ها</option>
                    <option value="Active" selected="@(Model.Status == "Active")">فعال</option>
                    <option value="OnLeave" selected="@(Model.Status == "OnLeave")">در مرخصی</option>
                    <option value="Terminated" selected="@(Model.Status == "Terminated")">خروج قطعی</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1"><i class="bi bi-search"></i> اعمال</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="BulkEdit" method="get">
        <p class="text-muted mb-2">
            @PersianDate.ToPersianDigits(Model.Result.TotalCount.ToString()) کارمند یافت شد
            @if (Model.Result.TotalCount > 0)
            {
                <text>- نمایش @PersianDate.ToPersianDigits($"{Model.Result.FirstItemIndex}-{Model.Result.LastItemIndex}")</text>
            }
        </p>
        <div class="table-responsive">
            <table class="table table-striped table-hover text-center align-middle">
                <thead class="table-primary">
                    <tr>
                        @if (canWrite)
                        {
                            <th><input class="form-check-input m-0" type="checkbox" data-select-all title="انتخاب همه کارکنان این صفحه" /></th>
                        }
                        <th>کد پرسنلی</th>
                        <th>نام و نام خانوادگی</th>
                        <th>عنوان شغلی</th>
                        <th>واحد سازمانی</th>
                        <th>مدیر مستقیم</th>
                        <th>ایمیل</th>
                        <th>تاریخ استخدام</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Result.Items.Count == 0)
                    {
                        <tr><td colspan="@(canWrite ? 10 : 9)" class="text-muted py-4">کارمندی با این شرایط یافت نشد.</td></tr>
                    }
                    @foreach (var employee in Model.Result.Items)
                    {
                        <tr>
                            @if (canWrite)
                            {
                                <td><input class="form-check-input m-0" type="checkbox" name="ids" value="@employee.EmployeeId" data-select-item aria-label="انتخاب @employee.FullName" /></td>
                            }
                            <td>@employee.EmployeeNumber</td>
                            <td class="fw-semibold">
                                <div class="d-flex align-items-center gap-2">
                                    @if (employee.HasPhoto)
                                    {
                                        <img src="@PhotoHref(employee.EmployeeId, employee.ModifiedDate)" alt="" class="avatar avatar-sm" />
                                    }
                                    else
                                    {
                                        <span class="avatar avatar-sm avatar-fallback" aria-hidden="true">@(employee.FirstName.Length > 0 ? employee.FirstName[..1] : "?")</span>
                                    }
                                    <span>@employee.FullName</span>
                                </div>
                            </td>
                            <td>@(employee.JobTitleName ?? "-")</td>
                            <td>@(employee.DepartmentName ?? "-")</td>
                            <td>@(employee.ManagerName ?? "-")</td>
                            <td dir="ltr">@employee.Email</td>
                            <td>@PersianDate.ToJalali(employee.HireDate)</td>
                            <td><span class="badge text-bg-@FaLabels.EmploymentStatusBadge(employee.EmploymentStatus)">@FaLabels.EmploymentStatus(employee.EmploymentStatus)</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@employee.EmployeeId" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                                @if (User.HasPermission(Permissions.EmployeesWrite))
                                {
                                    <a asp-action="Edit" asp-route-id="@employee.EmployeeId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Result.PageCount > 1)
        {
            <nav class="d-flex justify-content-center gap-1">
                @if (Model.Result.HasPreviousPage)
                {
                    <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-all-route-data="routeData" asp-route-page="@(Model.Page - 1)">صفحه قبل</a>
                }
                <span class="btn btn-sm btn-light">صفحه @PersianDate.ToPersianDigits($"{Model.Page}") از @PersianDate.ToPersianDigits($"{Model.Result.PageCount}")</span>
                @if (Model.Result.HasNextPage)
                {
                    <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-all-route-data="routeData" asp-route-page="@(Model.Page + 1)">صفحه بعد</a>
                }
            </nav>
        }

        @if (canWrite)
        {
            <div class="d-flex justify-content-end mt-3">
                <button type="submit" class="btn btn-primary" data-bulk-submit>
                    <i class="bi bi-pencil-square"></i> تغییر در انتخاب‌شده‌ها
                </button>
            </div>
        }
        </form>
    </div>
</div>
