@model DashboardViewModel
@{
    var self = Model.CurrentEmployee;
    var showWelcome = TempData["Welcome"] is bool welcome && welcome;
    var canReadTimeOff = User.HasPermission(Permissions.TimeOffRead);
    var canRequest = self is not null && User.HasPermission(Permissions.TimeOffRequest);
    var canBrowsePeople = User.HasPermission(Permissions.EmployeesRead);
}
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <div>
            <h1>سلام @Model.EmployeeName، امروز چطور می‌توانم کمکتان کنم؟</h1>
            <p class="hero-sub">
                @if (Model.CanViewOrganization)
                {
                    <text>خلاصه امروز: @PersianDate.ToPersianDigits(Model.Stats.TotalEmployees.ToString()) کارمند، @PersianDate.ToPersianDigits(Model.Stats.PendingRequests.ToString()) درخواست در انتظار</text>
                }
                else
                {
                    <text>مرخصی، اطلاعات شخصی و درخواست‌های خود را از اینجا پیگیری کنید.</text>
                }
            </p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-hero" data-bs-toggle="modal" data-bs-target="#welcomeModal"><i class="bi bi-question-circle"></i> راهنمای شروع</button>
            @if (User.HasPermission(Permissions.EmployeesWrite))
            {
                <a asp-controller="Employees" asp-action="Create" class="btn btn-hero"><i class="bi bi-person-plus"></i> افزودن کارمند</a>
            }
        </div>
    </div>
}

<div class="home-workspace">
    <aside class="home-sidebar" aria-label="خلاصهٔ کاربر و مرخصی">
        <section class="card home-profile-card">
            <div class="card-body d-flex align-items-center gap-3">
                @if (self?.HasPhoto == true)
                {
                    <img src="/Employees/Photo/@self.EmployeeId?v=@self.ModifiedDate.ToString("yyyyMMddHHmmss")" class="avatar avatar-md" alt="تصویر @self.FullName" />
                }
                else
                {
                    <span class="avatar avatar-md avatar-fallback" aria-hidden="true"><i class="bi bi-person"></i></span>
                }
                <div class="home-profile-text">
                    <strong>@Model.EmployeeName</strong>
                    <span>@(self?.JobTitleName ?? "حساب کاربری")</span>
                    @if (self is not null)
                    {
                        <a asp-controller="Home" asp-action="Profile">مشاهدهٔ پروندهٔ من <i class="bi bi-chevron-left"></i></a>
                    }
                </div>
            </div>
        </section>

        @if (canReadTimeOff)
        {
            <section class="card home-balances">
                <div class="card-header"><h2><i class="bi bi-calendar-check"></i> مرخصی من</h2></div>
                <div class="card-body">
                    @if (self is null)
                    {
                        <p class="home-empty">پروندهٔ پرسنلی به این حساب متصل نیست.</p>
                    }
                    else if (Model.MyBalances.Count == 0)
                    {
                        <p class="home-empty">برای شما ماندهٔ مرخصی ثبت نشده است.</p>
                    }
                    else
                    {
                        <p class="home-balance-year">سال محاسباتی: @PersianDate.ToPersianDigits(Model.BalanceYear.ToString()) میلادی · واحد: ساعت</p>
                        @foreach (var balance in Model.MyBalances)
                        {
                            <div class="home-balance-policy">
                                <div><strong>@balance.PolicyName</strong><span class="@(balance.AvailableHours < 0 && !balance.Unlimited ? "text-danger" : "text-primary")">@(balance.Unlimited ? "بدون سقف" : PersianDate.ToPersianDigits(balance.AvailableHours.ToString("0.##")) + " ساعت")</span></div>
                                <small>استفاده‌شده: @PersianDate.ToPersianDigits(balance.UsedHours.ToString("0.##")) · در انتظار: @PersianDate.ToPersianDigits(balance.PendingHours.ToString("0.##")) ساعت</small>
                            </div>
                        }
                    }
                    @if (canRequest)
                    {
                        <a asp-controller="TimeOff" asp-action="CreateRequest" class="btn btn-primary w-100 mt-3"><i class="bi bi-plus-lg"></i> درخواست مرخصی</a>
                    }
                    @if (self is not null)
                    {
                        <a asp-controller="TimeOff" asp-action="Index" asp-route-employeeId="@self.EmployeeId" class="home-all-link">مانده و تاریخچهٔ کامل <i class="bi bi-chevron-left"></i></a>
                    }
                </div>
            </section>
        }

        @if (Model.AbsenceDays.Count > 0)
        {
            <section class="card home-availability">
                <div class="card-header"><h2><i class="bi bi-person-dash"></i> @(canBrowsePeople ? "مرخصی همکاران" : "مرخصی‌های من")</h2></div>
                <div class="card-body">
                    <ul class="nav nav-pills home-day-tabs" role="tablist" aria-label="روزهای مرخصی">
                        @for (var i = 0; i < Model.AbsenceDays.Count; i++)
                        {
                            <li class="nav-item" role="presentation"><button class="nav-link @(i == 0 ? "active" : "")" id="home-day-tab-@i" data-bs-toggle="tab" data-bs-target="#home-day-@i" type="button" role="tab" aria-controls="home-day-@i" aria-selected="@(i == 0 ? "true" : "false")">@Model.AbsenceDays[i].Caption</button></li>
                        }
                    </ul>
                    <div class="tab-content">
                        @for (var i = 0; i < Model.AbsenceDays.Count; i++)
                        {
                            var day = Model.AbsenceDays[i];
                            <div class="tab-pane @(i == 0 ? "show active" : "")" id="home-day-@i" role="tabpanel" aria-labelledby="home-day-tab-@i">
                                <p class="home-day-date">@PersianDate.ToPersianDigits(PersianDate.ToJalali(day.Date))</p>
                                @if (day.People.Count == 0)
                                {
                                    <p class="home-empty">مرخصی تأییدشده‌ای برای این روز ثبت نشده است.</p>
                                }
                                @foreach (var person in day.People)
                                {
                                    <a asp-controller="Employees" asp-action="Details" asp-route-id="@person.EmployeeId" class="home-absent-person"><i class="bi bi-person-circle"></i><span>@person.EmployeeName<small>@person.DepartmentName</small></span></a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
        @if (Model.CanBrowsePeople)
        {
            <partial name="_Celebrations" model="Model" />
        }
        <partial name="_OrganizationLinks" model="Model" />
    </aside>

    <div class="home-content">
        <section class="card home-shortcut-card" aria-labelledby="shortcuts-title">
            <div class="card-header"><h2 id="shortcuts-title"><i class="bi bi-grid"></i> دسترسی سریع</h2><span class="small text-muted">کارهای پرتکرار شما</span></div>
            <div class="card-body">
                @if (Model.Shortcuts.Count == 0)
                {
                    <p class="home-empty">هنوز دسترسی فعالی برای این حساب تعریف نشده است.</p>
                }
                <div class="home-shortcuts">
                    @foreach (var shortcut in Model.Shortcuts)
                    {
                        <a asp-controller="@shortcut.Controller" asp-action="@shortcut.Action" asp-route-employeeId="@shortcut.EmployeeId" class="home-shortcut"><i class="bi @shortcut.Icon"></i><span><strong>@shortcut.Title</strong><small>@shortcut.Description</small></span><i class="bi bi-chevron-left home-shortcut-arrow"></i></a>
                    }
                </div>
            </div>
        </section>

        @if (Model.CanBrowsePeople)
        {
            <partial name="_NewHires" model="Model" />
        }

        @if (Model.AwaitingMyApproval.Count > 0)
        {
            <section class="card home-approvals">
                <div class="card-header"><h2><i class="bi bi-check2-circle"></i> منتظر تصمیم شما</h2><a asp-controller="TimeOff" asp-action="Approvals" class="btn btn-sm btn-outline-primary">رفتن به صف تأیید</a></div>
                <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>کارمند</th><th>نوع</th><th>از</th><th>ساعت</th></tr></thead><tbody>
                    @foreach (var request in Model.AwaitingMyApproval.Take(6))
                    {
                        <tr><td>@request.EmployeeName</td><td>@request.PolicyName</td><td>@PersianDate.ToPersianDigits(PersianDate.ToJalali(request.StartDate))</td><td>@PersianDate.ToPersianDigits($"{request.TotalHours:0.##}")</td></tr>
                    }
                </tbody></table></div>
            </section>
        }

        @if (canReadTimeOff && self is not null)
        {
            <section class="card home-requests">
                <div class="card-header"><h2><i class="bi bi-clock-history"></i> آخرین درخواست‌های من</h2><a asp-controller="TimeOff" asp-action="Index" asp-route-employeeId="@self.EmployeeId" class="home-header-link">مشاهدهٔ همه <i class="bi bi-chevron-left"></i></a></div>
                @if (Model.RecentRequests.Count == 0)
                {
                    <div class="card-body"><p class="home-empty">هنوز درخواستی ثبت نکرده‌اید.</p></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>نوع مرخصی</th><th>بازهٔ زمانی</th><th>ساعت</th><th>وضعیت</th></tr></thead><tbody>
                        @foreach (var request in Model.RecentRequests)
                        {
                            <tr><td>@request.PolicyName</td><td>@PersianDate.ToPersianDigits(PersianDate.ToJalali(request.StartDate)) تا @PersianDate.ToPersianDigits(PersianDate.ToJalali(request.EndDate))</td><td>@PersianDate.ToPersianDigits($"{request.TotalHours:0.##}")</td><td><span class="badge text-bg-@FaLabels.RequestStatusBadge(request.Status)">@FaLabels.RequestStatus(request.Status)</span></td></tr>
                        }
                    </tbody></table></div>
                }
            </section>
        }

        @if (Model.CanViewOrganization)
        {
            <section class="home-organization" aria-labelledby="organization-title"><div class="home-section-heading"><h2 id="organization-title">نمای سازمان</h2><a asp-controller="Reports" asp-action="Index">همهٔ گزارش‌ها <i class="bi bi-chevron-left"></i></a></div><partial name="_OrganizationOverview" model="Model.Stats" /></section>
        }
    </div>
</div>

<div class="modal fade" id="welcomeModal" tabindex="-1" aria-labelledby="welcome-title" aria-hidden="true" data-auto-open="@(showWelcome ? "true" : "false")">
    <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="welcome-title">خوش آمدید @Model.EmployeeName</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button></div>
        <div class="modal-body"><p>خلاصهٔ کاربر و مرخصی در ستون کناری و میان‌برها و درخواست‌های شما در بخش اصلی قرار دارند. این راهنما را هر زمان از دکمهٔ «راهنمای شروع» باز کنید.</p><div class="home-guide-links">
            @foreach (var shortcut in Model.Shortcuts)
            {
                <a asp-controller="@shortcut.Controller" asp-action="@shortcut.Action" asp-route-employeeId="@shortcut.EmployeeId"><i class="bi @shortcut.Icon"></i> @shortcut.Title</a>
            }
        </div></div>
        <div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">شروع کار</button></div>
    </div></div>
</div>
@section Scripts {
    <script>
        (() => {
            const guide = document.getElementById('welcomeModal');
            if (guide?.dataset.autoOpen === 'true' && window.bootstrap) new bootstrap.Modal(guide).show();
        })();
    </script>
}
