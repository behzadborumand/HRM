@model DashboardViewModel
<section class="card home-new-hires">
    <div class="card-header"><h2><i class="bi bi-person-plus"></i> به همکاران تازه‌وارد خوش آمد می‌گوییم</h2><span class="small text-muted">۳۰ روز گذشته</span></div>
    <div class="card-body">
        @if (Model.NewHires.Count == 0)
        {
            <p class="home-empty">در ۳۰ روز گذشته همکار تازه‌ای به سازمان نپیوسته است.</p>
        }
        <div class="home-new-hires-list">
            @foreach (var person in Model.NewHires)
            {
                <a asp-controller="Employees" asp-action="Details" asp-route-id="@person.EmployeeId" class="home-person-row">
                    @if (person.HasPhoto)
                    {
                        <img src="/Employees/Photo/@person.EmployeeId" class="avatar" alt="تصویر @person.FullName" loading="lazy" />
                    }
                    else
                    {
                        <span class="avatar avatar-fallback" aria-hidden="true"><i class="bi bi-person"></i></span>
                    }
                    <span><strong>@person.FullName</strong><small>@person.JobTitle</small><small>شروع همکاری: @PersianDate.ToPersianDigits(PersianDate.ToJalali(person.HireDate))</small></span>
                </a>
            }
        </div>
    </div>
</section>
