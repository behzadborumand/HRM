@model HRMS.Core.Dtos.DashboardStats
@{
    var stats = Model;
    var maxHeadcount = stats.HeadcountByDepartment.Count == 0 ? 1 : Math.Max(1, stats.HeadcountByDepartment.Max(d => d.Headcount));
}
<div class="row g-3 mt-1">
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <h5 class="card-title text-muted"><i class="bi bi-people text-primary"></i> کل کارکنان</h5>
                <p class="stat-value">@PersianDate.ToPersianDigits(stats.TotalEmployees.ToString())</p>
                <a asp-controller="Reports" asp-action="EmployeesList">مشاهده لیست <i class="bi bi-arrow-left"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <h5 class="card-title text-muted"><i class="bi bi-person-check text-primary"></i> فعال</h5>
                <p class="stat-value">@PersianDate.ToPersianDigits(stats.ActiveEmployees.ToString())</p>
                <span class="small text-muted">در مرخصی: @PersianDate.ToPersianDigits(stats.OnLeaveEmployees.ToString())</span>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <h5 class="card-title text-muted"><i class="bi bi-calendar-event text-primary"></i> درخواست در انتظار</h5>
                <p class="stat-value">@PersianDate.ToPersianDigits(stats.PendingRequests.ToString())</p>
                @if (User.HasPermission(Permissions.TimeOffApprove))
                {
                    <a asp-controller="TimeOff" asp-action="Approvals">بررسی درخواست‌ها <i class="bi bi-arrow-left"></i></a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <h5 class="card-title text-muted"><i class="bi bi-diagram-3 text-primary"></i> واحدهای سازمانی</h5>
                <p class="stat-value">@PersianDate.ToPersianDigits(stats.DepartmentCount.ToString())</p>
                <a asp-controller="Reports" asp-action="Index">مشاهده گزارش‌ها <i class="bi bi-arrow-left"></i></a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-bar-chart"></i> توزیع کارکنان در واحدها</div>
            <div class="card-body">
                @if (stats.HeadcountByDepartment.Count == 0)
                {
                    <p class="text-muted mb-0">هنوز واحد سازمانی با کارمند تعریف نشده است.</p>
                }
                @foreach (var department in stats.HeadcountByDepartment)
                {
                    <div class="mb-2">
                        <div class="d-flex justify-content-between small">
                            <span>@department.DepartmentName</span>
                            <span>@PersianDate.ToPersianDigits(department.Headcount.ToString()) نفر</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar" style="width: @(Math.Round(department.Headcount * 100.0 / maxHeadcount))%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-pie-chart"></i> وضعیت درخواست‌های مرخصی</div>
            <div class="card-body">
                <table class="table table-sm text-center align-middle mb-0">
                    <thead><tr><th>وضعیت</th><th>تعداد</th><th>ساعت</th></tr></thead>
                    <tbody>
                        @if (stats.RequestStatusBreakdown.Count == 0)
                        {
                            <tr><td colspan="3" class="text-muted">درخواستی ثبت نشده است.</td></tr>
                        }
                        @foreach (var row in stats.RequestStatusBreakdown)
                        {
                            <tr>
                                <td><span class="badge text-bg-@FaLabels.RequestStatusBadge(row.Status)">@FaLabels.RequestStatus(row.Status)</span></td>
                                <td>@PersianDate.ToPersianDigits(row.Count.ToString())</td>
                                <td>@PersianDate.ToPersianDigits(row.Hours.ToString("0.##"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

