@model OrganizationLinksViewModel
@{ ViewData["Title"] = "پیوندهای سازمانی"; }
@section Hero {
    <div class="d-flex justify-content-between gap-3 flex-wrap align-items-center"><h1>پیوندهای سازمانی</h1><a asp-controller="Settings" asp-action="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> تنظیمات</a></div>
}
<p class="text-muted small">پیوندهای فعال در صفحهٔ اصلی همهٔ کاربران نمایش داده می‌شوند. عدد کوچک‌تر، بالاتر قرار می‌گیرد.</p>
<div class="row g-3">
    <div class="@(User.HasPermission(Permissions.OrgWrite) ? "col-lg-7" : "col-12")">
        <section class="card"><div class="card-header">پیوندهای ثبت‌شده</div>
            @if (Model.Rows.Count == 0)
            {
                <div class="card-body text-muted">هنوز پیوندی ثبت نشده است.</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-striped align-middle mb-0"><thead><tr><th>عنوان و توضیح</th><th>ترتیب</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr><td><strong>@row.Title</strong><div class="small text-muted text-break">@row.Description</div><div class="small text-muted text-break" dir="ltr">@row.Url</div></td><td>@PersianDate.ToPersianDigits(row.SortOrder.ToString())</td><td><span class="badge text-bg-@(row.Active ? "success" : "secondary")">@(row.Active ? "فعال" : "غیرفعال")</span></td><td>
                        @if (User.HasPermission(Permissions.OrgWrite))
                        {
                            <a asp-action="Index" asp-route-edit="@row.LinkId" class="btn btn-sm btn-outline-secondary" aria-label="ویرایش @row.Title"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" method="post" class="d-inline"><input type="hidden" name="id" value="@row.LinkId" /><button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف @row.Title" onclick="return confirm('این پیوند حذف شود؟');"><i class="bi bi-trash"></i></button></form>
                        }
                    </td></tr>
                }
                </tbody></table></div>
            }
        </section>
    </div>
    @if (User.HasPermission(Permissions.OrgWrite))
    {
        <div class="col-lg-5"><section class="card"><div class="card-header">@(Model.LinkId.HasValue ? "ویرایش پیوند" : "افزودن پیوند")</div><div class="card-body">
            <form asp-action="Save" method="post">
                <div asp-validation-summary="All" class="text-danger small"></div>
                <input type="hidden" asp-for="LinkId" />
                <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger small"></span></div>
                <div class="mb-3"><label asp-for="Url" class="form-label"></label><input asp-for="Url" class="form-control" dir="ltr" type="url" placeholder="https://example.com" /><span asp-validation-for="Url" class="text-danger small"></span><div class="form-text">نشانی کامل HTTP یا HTTPS؛ بدون نام کاربری و رمز.</div></div>
                <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
                <div class="mb-3"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" class="form-control" dir="ltr" min="0" max="9999" /></div>
                <div class="form-check form-switch mb-3"><input asp-for="Active" class="form-check-input" /><label asp-for="Active" class="form-check-label"></label></div>
                <button type="submit" class="btn btn-primary">ذخیره</button><a asp-action="Index" class="btn btn-light">انصراف</a>
            </form>
        </div></section></div>
    }
</div>
