@model ApprovalQueueViewModel
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <h1>صف تایید درخواست‌های مرخصی</h1>
        <a asp-action="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> مرخصی من</a>
    </div>
}

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-hourglass-split"></i> @PersianDate.ToPersianDigits(Model.Pending.Count.ToString()) درخواست در انتظار تصمیم</span>
        @if (Model.SeeAll)
        {
            <span class="badge text-bg-info">نمایش همه کارکنان (مدیر سیستم)</span>
        }
        else
        {
            <span class="badge text-bg-light">فقط زیرمجموعه من</span>
        }
    </div>
    <div class="card-body">
        @if (Model.Pending.Count == 0)
        {
            <p class="text-muted text-center py-4 mb-0">درخواست در انتظاری وجود ندارد.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle text-center">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>کارمند</th>
                            <th>واحد</th>
                            <th>نوع مرخصی</th>
                            <th>بازه</th>
                            <th>ساعت</th>
                            <th>توضیح کارمند</th>
                            <th>تصمیم</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.Pending)
                        {
                            <tr>
                                <td>@PersianDate.ToPersianDigits(request.RequestId.ToString())</td>
                                <td class="fw-semibold">
                                    <a asp-controller="Employees" asp-action="Details" asp-route-id="@request.EmployeeId">@request.EmployeeName</a>
                                </td>
                                <td>@(request.DepartmentName ?? "-")</td>
                                <td>@request.PolicyName</td>
                                <td class="small">
                                    @PersianDate.ToJalali(request.StartDate) تا @PersianDate.ToJalali(request.EndDate)
                                    <div class="text-muted">@PersianDate.ToJalali(request.RequestedDate)</div>
                                </td>
                                <td>@PersianDate.ToPersianDigits($"{request.TotalHours:0.##}")</td>
                                <td class="text-muted small">@(request.Reason ?? "-")</td>
                                <td>
                                    <form asp-action="Approve" method="post" class="d-flex gap-1 justify-content-center flex-wrap">
                                        <input type="hidden" name="requestId" value="@request.RequestId" />
                                        <input type="text" name="comments" class="form-control form-control-sm" style="min-width: 130px;" placeholder="توضیح مدیر (اختیاری)" />
                                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> تایید</button>
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                formaction="@Url.Action("Reject")"><i class="bi bi-x-lg"></i> رد</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
