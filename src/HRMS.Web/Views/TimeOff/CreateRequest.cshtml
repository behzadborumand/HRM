@model TimeOffRequestFormViewModel
@{
    var policyOptions = new SelectList(Model.Policies, "PolicyId", "PolicyName", Model.PolicyId);
}
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <h1>ثبت درخواست مرخصی</h1>
        <a asp-action="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> بازگشت</a>
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-primary text-white"><i class="bi bi-calendar-plus"></i> مشخصات درخواست</div>
            <div class="card-body">
                <form asp-action="CreateRequest" method="post">
                    @if (Model.CanChooseEmployee)
                    {
                        <div class="mb-3">
                            <label asp-for="EmployeeId" class="form-label"></label>
                            <select asp-for="EmployeeId" class="form-select" asp-items="@(new SelectList(Model.Employees, "EmployeeId", "FullName"))"></select>
                            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="EmployeeId" />
                    }

                    <div class="mb-3">
                        <label asp-for="PolicyId" class="form-label"></label>
                        <select asp-for="PolicyId" class="form-select" asp-items="policyOptions">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="PolicyId" class="text-danger small"></span>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input class="form-control" type="text" id="StartDate" name="StartDate" dir="ltr" autocomplete="off"
                                   placeholder="۱۴۰۵/۰۸/۱۲" value="@PersianDate.ToJalaliInput(Model.StartDate)" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input class="form-control" type="text" id="EndDate" name="EndDate" dir="ltr" autocomplete="off"
                                   placeholder="۱۴۰۵/۰۸/۱۵" value="@PersianDate.ToJalaliInput(Model.EndDate)" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-light border mt-3 mb-3">
                        <span class="fw-semibold">برآورد ساعت:</span>
                        <span id="estimatedHours">@PersianDate.ToPersianDigits(Model.EstimatedHours.ToString())</span> ساعت
                        <span class="text-muted small">(روزهای تعطیل جمعه محاسبه نمی‌شود)</span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label"></label>
                        <textarea asp-for="Reason" class="form-control" rows="3" placeholder="دلیل مرخصی را بنویسید"></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> ارسال درخواست</button>
                    <a asp-action="Index" class="btn btn-secondary">انصراف</a>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-bank"></i> مانده فعلی</div>
            <div class="card-body">
                @if (Model.Balances.Count == 0)
                {
                    <p class="text-muted mb-0">مانده‌ای برای این کارمند ثبت نشده است.</p>
                }
                else
                {
                    <table class="table table-sm text-center align-middle mb-0">
                        <thead><tr><th>سیاست</th><th>مانده</th></tr></thead>
                        <tbody>
                            @foreach (var balance in Model.Balances)
                            {
                                <tr>
                                    <td class="text-start">@balance.PolicyName</td>
                                    <td>
                                        @if (balance.Unlimited)
                                        {
                                            <span class="badge text-bg-secondary">بدون سقف</span>
                                        }
                                        else
                                        {
                                            <span class="@(balance.AvailableHours - balance.PendingHours >= 0 ? "text-success fw-semibold" : "text-danger fw-semibold")">
                                                @PersianDate.ToPersianDigits(balance.AvailableHours.ToString("0.##"))
                                            </span>
                                            <span class="text-muted small">/ @PersianDate.ToPersianDigits(balance.AccruedHours.ToString("0.##"))</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const start = document.getElementById('StartDate');
            const end = document.getElementById('EndDate');
            const output = document.getElementById('estimatedHours');
            const toFa = (n) => String(n).replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[d]);
            function recalc() {
                if (!start.value || !end.value) { return; }
                let total = 0;
                for (let d = new Date(start.value); d <= new Date(end.value); d.setDate(d.getDate() + 1)) {
                    if (d.getDay() !== 5) { total += 8; }
                }
                output.textContent = toFa(total);
            }
            start.addEventListener('change', recalc);
            end.addEventListener('change', recalc);
        })();
    </script>
}
