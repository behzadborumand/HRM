@model LoginViewModel
@{
    Layout = "_Layout";
}
<div class="card login-card shadow-sm">
    <div class="card-header bg-primary text-white text-center"><h5 class="mb-0"><i class="bi bi-shield-lock"></i> ورود به سامانه منابع انسانی</h5></div>
    <div class="card-body p-4">
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autofocus dir="ltr" placeholder="admin" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" dir="ltr" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-left"></i> ورود</button>
        </form>
        <hr />
        <p class="small text-muted mb-0">
            حساب‌های نمونه: <code dir="ltr">admin / Admin@1234</code> -
            <code dir="ltr">hr.manager / Manager@1234</code> -
            <code dir="ltr">m.kazemi / User@1234</code>
        </p>
    </div>
</div>
