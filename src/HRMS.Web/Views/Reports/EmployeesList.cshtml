@model EmployeesReportViewModel
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <h1>گزارش لیست کارکنان</h1>
        <div class="d-flex gap-2">
            <a asp-action="ExportEmployees" asp-all-route-data="@(new Dictionary<string, string> { ["keyword"] = Model.Keyword ?? string.Empty, ["departmentId"] = Model.DepartmentId?.ToString() ?? string.Empty, ["status"] = Model.Status ?? string.Empty })"
               class="btn btn-hero"><i class="bi bi-file-earmark-spreadsheet"></i> خروجی CSV</a>
            <button type="button" class="btn btn-hero" onclick="window.print();"><i class="bi bi-printer"></i> چاپ</button>
            <a asp-action="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> گزارش‌ها</a>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="keyword">جستجو</label>
                <input type="search" class="form-control" id="keyword" name="keyword" value="@Model.Keyword" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="departmentId">واحد سازمانی</label>
                <select class="form-select" id="departmentId" name="departmentId"
                        asp-items="@(new SelectList(Model.Departments, "DepartmentId", "DepartmentName", Model.DepartmentId))">
                    <option value="">همه واحدها</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="status">وضعیت</label>
                <select class="form-select" id="status" name="status">
                    <option value="">همه</option>
                    <option value="Active" selected="@(Model.Status == "Active")">فعال</option>
                    <option value="OnLeave" selected="@(Model.Status == "OnLeave")">در مرخصی</option>
                    <option value="Terminated" selected="@(Model.Status == "Terminated")">خروج قطعی</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">اجرا</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-sm align-middle text-center">
            <thead>
                <tr>
                    <th>کد</th><th>نام</th><th>عنوان شغلی</th><th>واحد</th><th>مدیر</th>
                    <th>ایمیل</th><th>استخدام</th><th>وضعیت</th><th>حقوق</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="9" class="text-muted py-4">داده‌ای برای نمایش وجود ندارد.</td></tr>
                }
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.EmployeeNumber</td>
                        <td class="text-start">@row.FullName</td>
                        <td>@(row.JobTitleName ?? "-")</td>
                        <td>@(row.DepartmentName ?? "-")</td>
                        <td>@(row.ManagerName ?? "-")</td>
                        <td dir="ltr" class="small">@row.Email</td>
                        <td>@PersianDate.ToJalali(row.HireDate)</td>
                        <td><span class="badge text-bg-@FaLabels.EmploymentStatusBadge(row.EmploymentStatus)">@FaLabels.EmploymentStatus(row.EmploymentStatus)</span></td>
                        <td>@PersianDate.ToPersianDigits(row.PayRate?.ToString("N0") ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="d-flex justify-content-between fw-semibold">
            <span>تعداد: @PersianDate.ToPersianDigits(Model.TotalHeadcount.ToString())</span>
            <span>جمع حقوق: @PersianDate.ToPersianDigits(Model.TotalPayroll.ToString("N0"))</span>
        </div>
    </div>
</div>
