@model HRMS.Core.Dtos.DashboardStats
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <h1>گزارش‌ها</h1>
        <a asp-controller="Home" asp-action="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> داشبورد</a>
    </div>
}

<div class="row g-3">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5><i class="bi bi-person-lines-fill text-primary"></i> گزارش لیست کارکنان</h5>
                <p class="text-muted small">فیلتر بر اساس واحد، وضعیت و نام، با خروجی CSV برای اکسل.</p>
                <a asp-action="EmployeesList" class="btn btn-primary">اجرای گزارش</a>
            </div>
            <div class="card-footer bg-white text-muted small">
                کل کارکنان: @PersianDate.ToPersianDigits(Model.TotalEmployees.ToString())
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5><i class="bi bi-calendar-check text-success"></i> گزارش خلاصه مرخصی</h5>
                <p class="text-muted small">تعلق گرفته، استفاده‌شده و مانده هر کارمند در سال انتخابی.</p>
                <a asp-action="TimeOffSummary" class="btn btn-success">اجرای گزارش</a>
            </div>
            <div class="card-footer bg-white text-muted small">
                در انتظار تایید: @PersianDate.ToPersianDigits(Model.PendingRequests.ToString())
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5><i class="bi bi-bar-chart text-info"></i> آمار سریع</h5>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between"><span>فعال</span><strong>@PersianDate.ToPersianDigits(Model.ActiveEmployees.ToString())</strong></li>
                    <li class="list-group-item d-flex justify-content-between"><span>در مرخصی</span><strong>@PersianDate.ToPersianDigits(Model.OnLeaveEmployees.ToString())</strong></li>
                    <li class="list-group-item d-flex justify-content-between"><span>استخدام جدید امسال</span><strong>@PersianDate.ToPersianDigits(Model.NewHiresThisYear.ToString())</strong></li>
                    <li class="list-group-item d-flex justify-content-between"><span>میان اندازه تیم</span><strong>@PersianDate.ToPersianDigits(Model.AverageTeamSize.ToString("0.#"))</strong></li>
                </ul>
            </div>
        </div>
    </div>
</div>
