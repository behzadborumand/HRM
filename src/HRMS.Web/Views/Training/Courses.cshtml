@model TrainingCoursesViewModel
@{
    var canWrite = User.HasPermission(Permissions.OrgWrite);
    var isEdit = Model.Form.CourseId is not null;
}
@section Hero {
    <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
        <div>
            <h1>کاتالوگ دوره‌های آموزشی</h1>
            <p class="hero-sub">دوره‌هایی که می‌توان به کارکنان واگذار کرد</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-hero"><i class="bi bi-arrow-right"></i> آموزش‌ها</a>
            <a asp-controller="Settings" asp-action="Index" class="btn btn-hero"><i class="bi bi-gear"></i> تنظیمات</a>
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white fw-semibold">لیست دوره‌ها</div>
            <div class="card-body table-responsive">
                <table class="table table-sm table-striped align-middle text-center mb-0">
                    <thead>
                        <tr>
                            <th>عنوان</th><th>دسته</th><th>برگزارکننده</th><th>تکرار</th><th>ثبت‌ها</th><th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Courses.Count == 0)
                        {
                            <tr><td colspan="6" class="text-muted">دوره‌ای ثبت نشده است.</td></tr>
                        }
                        @foreach (var course in Model.Courses)
                        {
                            <tr class="@(course.Active ? null : "text-muted")">
                                <td class="text-start">
                                    @course.Title
                                    @if (course.MandatoryForAll)
                                    {
                                        <span class="badge text-bg-light ms-1">اجباری</span>
                                    }
                                    @if (!course.Active)
                                    {
                                        <span class="badge text-bg-secondary ms-1">غیرفعال</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(course.Description))
                                    {
                                        <div class="small text-muted">@course.Description</div>
                                    }
                                </td>
                                <td>@(course.Category ?? "-")</td>
                                <td>@(course.Provider ?? "-")</td>
                                <td>@(course.RenewalDays is null ? "-" : PersianDate.ToPersianDigits($"{course.RenewalDays} روز"))</td>
                                <td>
                                    @PersianDate.ToPersianDigits(course.AssignedCount.ToString())
                                    @if (course.OpenCount > 0)
                                    {
                                        <span class="text-danger small"> (@PersianDate.ToPersianDigits(course.OpenCount.ToString()) باز)</span>
                                    }
                                </td>
                                <td>
                                    @if (canWrite)
                                    {
                                        <a asp-action="Courses" asp-route-edit="@course.CourseId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="DeleteCourse" method="post" class="d-inline"
                                              onsubmit="return confirm('این دوره حذف شود؟');">
                                            <input type="hidden" name="courseId" value="@course.CourseId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (canWrite)
    {
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header bg-primary text-white">@(isEdit ? "ویرایش دوره" : "افزودن دوره آموزشی")</div>
                <div class="card-body">
                    <form asp-action="SaveCourse" method="post">
                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="Form.CourseId" />
                        }
                        <div class="mb-3">
                            <label asp-for="Form.Title" class="form-label"></label>
                            <input asp-for="Form.Title" class="form-control" />
                            <span asp-validation-for="Form.Title" class="text-danger small"></span>
                        </div>
                        <div class="row g-2">
                            <div class="col-6 mb-3">
                                <label asp-for="Form.Category" class="form-label"></label>
                                <input asp-for="Form.Category" class="form-control" />
                            </div>
                            <div class="col-6 mb-3">
                                <label asp-for="Form.RenewalDays" class="form-label"></label>
                                <input asp-for="Form.RenewalDays" class="form-control" />
                                <span asp-validation-for="Form.RenewalDays" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Form.Provider" class="form-label"></label>
                            <input asp-for="Form.Provider" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Form.Description" class="form-label"></label>
                            <textarea asp-for="Form.Description" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" asp-for="Form.MandatoryForAll" />
                            <label class="form-check-label" asp-for="Form.MandatoryForAll"></label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" asp-for="Form.Active" />
                            <label class="form-check-label" asp-for="Form.Active"></label>
                        </div>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> ذخیره</button>
                        @if (isEdit)
                        {
                            <a asp-action="Courses" class="btn btn-outline-secondary">انصراف</a>
                        }
                    </form>
                </div>
            </div>
        </div>
    }
</div>
